{
  "id": "mini-notes",
  "name": "Mini Notes",
  "description": "โน้ตหรือ To-do list ขนาดเล็ก",
  "version": "1.0.0",
  "author": "GNOME Widget Center",
  "api-version": 1,
  "entry": "widget.js",
  "block-type": "1x1",
  "default-position": {
    "x": 224,
    "y": 16,
    "monitor": 0
  },
  "settings": [
    {
      "id": "noteText",
      "type": "string",
      "label": "ข้อความโน้ต",
      "default": "- Buy groceries\n- Call mom\n- Finish project"
    },
    {
      "id": "backgroundColor",
      "type": "color",
      "label": "สีพื้นหลัง",
      "default": "#fff5b1"
    },
    {
      "id": "shadowEnabled",
      "type": "boolean",
      "label": "Enable shadow",
      "default": false
    },
    {
      "id": "shadowColor",
      "type": "color",
      "label": "Shadow color",
      "default": "#000000"
    },
    {
      "id": "shadowOpacity",
      "type": "range",
      "label": "Shadow transparency (%)",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "id": "shadowAngle",
      "type": "range",
      "label": "Shadow angle (degrees)",
      "default": 90,
      "min": 0,
      "max": 360,
      "step": 1
    },
    {
      "id": "shadowDistance",
      "type": "range",
      "label": "Shadow distance (px)",
      "default": 6,
      "min": 0,
      "max": 60,
      "step": 1
    },
    {
      "id": "shadowBlur",
      "type": "range",
      "label": "Shadow blur (px)",
      "default": 16,
      "min": 0,
      "max": 100,
      "step": 1
    }
  ]
}
