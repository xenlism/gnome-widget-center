{
  "version": "1.0",
  "tabs": [
    {
      "id": "general",
      "label": "Daily Wallpaper",
      "description": "Automatically refresh a desktop wallpaper from a keyless image provider.",
      "icon": "preferences-desktop-wallpaper-symbolic",
      "groups": [
        {
          "id": "provider",
          "label": "Provider",
          "description": "All providers work without an API key. Images are downloaded to a local cache.",
          "fields": [
            {
              "id": "provider",
              "label": "Image provider",
              "description": "Bing Daily selects from recent Bing homepage images; Wikimedia Commons selects a featured picture; Lorem Picsum returns a random photo.",
              "dataType": "string",
              "fieldType": "dropdown",
              "default": "bing",
              "options": [
                {
                  "value": "bing",
                  "label": "Bing Daily (no key)"
                },
                {
                  "value": "wikimedia",
                  "label": "Wikimedia Commons (no key)"
                },
                {
                  "value": "picsum",
                  "label": "Lorem Picsum (no key)"
                }
              ]
            },
            {
              "id": "downloadResolution",
              "label": "Download resolution",
              "description": "Choose automatic primary-monitor detection or a fixed download size.",
              "dataType": "string",
              "fieldType": "dropdown",
              "default": "screen",
              "options": [
                {
                  "value": "screen",
                  "label": "Detect screen resolution"
                },
                {
                  "value": "1080p",
                  "label": "Full HD (1920×1080)"
                },
                {
                  "value": "1440p",
                  "label": "QHD (2560×1440)"
                },
                {
                  "value": "4k",
                  "label": "4K UHD (3840×2160)"
                }
              ]
            },
            {
              "id": "refreshHours",
              "label": "Refresh image every",
              "description": "The widget refreshes its image after this many hours. Minimum 1 hour.",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 24,
              "min": 1,
              "max": 168,
              "step": 1,
              "suffix": "hours"
            },
            {
              "id": "autoApplyWallpaper",
              "label": "Auto apply as desktop wallpaper",
              "description": "Set every newly loaded image (timed refresh, Random, or changed settings) as the desktop wallpaper automatically, using the scaling mode below.",
              "dataType": "boolean",
              "fieldType": "switch",
              "default": false
            },
            {
              "id": "showAttribution",
              "label": "Show provider / attribution",
              "description": "Show provider and available author/copyright information on the card.",
              "dataType": "boolean",
              "fieldType": "switch",
              "default": true
            }
          ]
        },
        {
          "id": "display",
          "label": "Display",
          "description": "Control how the image is shown in the widget and applied to the desktop.",
          "fields": [
            {
              "id": "fitMode",
              "label": "Widget image display",
              "description": "Cover crops to fill; Contain shows the whole image; Stretch fills the card without preserving aspect ratio.",
              "dataType": "string",
              "fieldType": "dropdown",
              "default": "cover",
              "options": [
                {
                  "value": "cover",
                  "label": "Cover / crop to fill"
                },
                {
                  "value": "contain",
                  "label": "Contain / fit inside"
                },
                {
                  "value": "stretch",
                  "label": "Stretch to fill"
                }
              ]
            },
            {
              "id": "wallpaperApplyMode",
              "label": "Desktop wallpaper scaling",
              "description": "GNOME picture-options mode used when Apply Wallpaper is clicked.",
              "dataType": "string",
              "fieldType": "dropdown",
              "default": "zoom",
              "options": [
                {
                  "value": "zoom",
                  "label": "Zoom / crop to fill"
                },
                {
                  "value": "scaled",
                  "label": "Scaled / fit within screen"
                },
                {
                  "value": "stretched",
                  "label": "Stretch to screen"
                },
                {
                  "value": "centered",
                  "label": "Centered / fixed size"
                },
                {
                  "value": "wallpaper",
                  "label": "Tiled"
                },
                {
                  "value": "spanned",
                  "label": "Span across monitors"
                }
              ]
            }
          ]
        },
        {
          "id": "card",
          "label": "Card",
          "description": "Card appearance settings.",
          "fields": [
            {
              "id": "card-background-color",
              "label": "Background color",
              "description": "Background visible while loading or when an image does not fill the card.",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "alpha": true,
              "default": "#151515FF",
              "schemeRole": "card-background"
            }
          ]
        }
      ]
    },
    {
      "id": "shadow",
      "label": "Shadow",
      "description": "Drop shadow behind this widget.",
      "groups": [
        {
          "id": "shadow",
          "label": "Shadow effect",
          "description": "Standard card shadow settings.",
          "fields": [
            {
              "id": "card-shadow-angle",
              "label": "Shadow angle",
              "dataType": "integer",
              "fieldType": "slider",
              "default": 90,
              "min": 0,
              "max": 360,
              "step": 1,
              "suffix": "°",
              "visibleIf": "card-shadow-enabled",
              "description": "Direction the shadow is cast, in degrees."
            },
            {
              "id": "card-shadow-distance",
              "label": "Shadow distance",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 6,
              "min": 0,
              "max": 60,
              "step": 1,
              "suffix": "px",
              "visibleIf": "card-shadow-enabled",
              "description": "How far the shadow is offset from the card."
            }
          ]
        }
      ]
    }
  ]
}