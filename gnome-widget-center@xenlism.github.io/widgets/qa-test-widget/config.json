{
  "version": "1.0",
  "tabs": [
    {
      "id": "general",
      "label": "QA Test Widget",
      "description": "Settings deliberately shaped to test .gwct export's secret redaction.",
      "groups": [
        {
          "id": "display",
          "label": "Display",
          "description": "Ordinary, non-secret settings - these SHOULD survive a .gwct export unchanged.",
          "fields": [
            {
              "id": "displayLabel",
              "label": "Label text",
              "description": "Shown on the widget itself.",
              "dataType": "string",
              "fieldType": "text",
              "default": "QA Test Widget xxxxx"
            },
            {
              "id": "refreshSeconds",
              "label": "Refresh interval",
              "description": "How often the widget re-renders.",
              "dataType": "number",
              "fieldType": "spinbutton",
              "default": 4,
              "min": 1,
              "max": 60,
              "step": 1,
              "suffix": "s"
            }
          ]
        },
        {
          "id": "secrets-explicit",
          "label": "Explicit secrets",
          "description": "Marked secret via fieldType/format - MUST be redacted from any .gwct export.",
          "fields": [
            {
              "id": "apiKey",
              "label": "API key",
              "description": "fieldType: password - the authoritative secret signal.",
              "dataType": "string",
              "fieldType": "password",
              "default": "ghhh5885446566666bgghjjk"
            },
            {
              "id": "contactEmail",
              "label": "Contact email",
              "description": "format: email - also authoritative, even though fieldType is plain text.",
              "dataType": "string",
              "fieldType": "text",
              "format": "email",
              "default": "xxxx@ssss.co"
            }
          ]
        },
        {
          "id": "secrets-heuristic",
          "label": "Name-only secrets",
          "description": "NOT marked password/email in the schema - only the field id/label look like a credential. Tests the name-heuristic fallback in lib/secretFields.js.",
          "fields": [
            {
              "id": "accountUsername",
              "label": "Account username",
              "description": "Plain fieldType: text - only the name says this is sensitive.",
              "dataType": "string",
              "fieldType": "text",
              "default": "xxxx"
            },
            {
              "id": "plainNote",
              "label": "Plain note",
              "description": "An ordinary field that happens to sit next to secret ones - MUST still survive export.",
              "dataType": "string",
              "fieldType": "textarea",
              "default": "nothing sensitive here ddddd"
            }
          ]
        },
        {
          "id": "nested",
          "label": "Nested accounts",
          "description": "A list of objects, one of whose nested fields is a secret - tests recursive redaction through list.item.properties.",
          "fields": [
            {
              "id": "accounts",
              "label": "Linked accounts",
              "description": "Each entry has a name and an access token.",
              "dataType": "list",
              "fieldType": "list",
              "default": [
                {
                  "accessToken": "5555555"
                },
                {
                  "accessToken": "xxxxxx"
                },
                {
                  "accessToken": "xxxxxx"
                },
                {
                  "accessToken": "888888"
                }
              ],
              "item": {
                "dataType": "object",
                "fieldType": "object",
                "properties": {
                  "name": {
                    "label": "Name",
                    "dataType": "string",
                    "fieldType": "text"
                  },
                  "accessToken": {
                    "label": "Access token",
                    "dataType": "string",
                    "fieldType": "password"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "field-types",
      "label": "All Field Types",
      "description": "One field per fieldType supported by config.json - a visual showcase/test surface, not meant to represent real widget behavior.",
      "groups": [
        {
          "id": "toggles",
          "label": "Toggles",
          "fields": [
            {
              "id": "enableFeatureSwitch",
              "label": "Switch",
              "description": "fieldType: switch",
              "dataType": "boolean",
              "fieldType": "switch",
              "default": true
            },
            {
              "id": "enableFeatureCheckbox",
              "label": "Checkbox",
              "description": "fieldType: checkbox",
              "dataType": "boolean",
              "fieldType": "checkbox",
              "default": true
            }
          ]
        },
        {
          "id": "choices",
          "label": "Choices",
          "fields": [
            {
              "id": "layoutMode",
              "label": "Dropdown",
              "description": "fieldType: dropdown",
              "dataType": "string",
              "fieldType": "dropdown",
              "default": "spacious",
              "options": [
                {
                  "value": "compact",
                  "label": "Compact"
                },
                {
                  "value": "comfortable",
                  "label": "Comfortable"
                },
                {
                  "value": "spacious",
                  "label": "Spacious"
                }
              ]
            },
            {
              "id": "alignMode",
              "label": "Radio",
              "description": "fieldType: radio",
              "dataType": "string",
              "fieldType": "radio",
              "default": "start",
              "options": [
                {
                  "value": "start",
                  "label": "Start"
                },
                {
                  "value": "center",
                  "label": "Center"
                },
                {
                  "value": "end",
                  "label": "End"
                }
              ]
            }
          ]
        },
        {
          "id": "numbers",
          "label": "Numbers",
          "fields": [
            {
              "id": "spinValue",
              "label": "Spinbutton",
              "description": "fieldType: spinbutton",
              "dataType": "number",
              "fieldType": "spinbutton",
              "default": 5,
              "min": 0,
              "max": 10,
              "step": 1
            },
            {
              "id": "sliderValue",
              "label": "Slider",
              "description": "fieldType: slider",
              "dataType": "number",
              "fieldType": "slider",
              "default": 30.5,
              "min": 0,
              "max": 100,
              "step": 5
            }
          ]
        },
        {
          "id": "pickers",
          "label": "Pickers",
          "fields": [
            {
              "id": "accentColor",
              "label": "Colorpicker",
              "description": "fieldType: colorpicker",
              "dataType": "string",
              "fieldType": "colorpicker",
              "default": "#3584e4"
            },
            {
              "id": "labelFont",
              "label": "Fontpicker",
              "description": "fieldType: fontpicker",
              "dataType": "string",
              "fieldType": "fontpicker",
              "default": "Adwaita Mono Bold Italic 11"
            },
            {
              "id": "widgetIcon",
              "label": "Iconpicker",
              "description": "fieldType: iconpicker",
              "dataType": "string",
              "fieldType": "iconpicker",
              "default": "applications-graphics-symbolic"
            },
            {
              "id": "importFile",
              "label": "Filepicker",
              "description": "fieldType: filepicker",
              "dataType": "string",
              "fieldType": "filepicker",
              "default": "/usr/share/icons/Adwaita/16x16/devices/audio-headphones.png"
            },
            {
              "id": "exportFolder",
              "label": "Folderpicker",
              "description": "fieldType: folderpicker",
              "dataType": "string",
              "fieldType": "folderpicker",
              "default": "/home/xenatt/Downloads"
            }
          ]
        },
        {
          "id": "plain-list",
          "label": "Plain list (non-object items)",
          "description": "A list of plain strings, not objects - exercises _staticAddWidget()'s inline staging control below the ListBox.",
          "fields": [
            {
              "id": "tags",
              "label": "Tags",
              "description": "Each item is just a string, added via the '+' control below the list.",
              "dataType": "list",
              "fieldType": "list",
              "default": [
                "example",
                "sssss",
                "cccc"
              ],
              "item": {
                "dataType": "string",
                "fieldType": "text"
              }
            }
          ]
        }
      ]
    }
  ]
}
