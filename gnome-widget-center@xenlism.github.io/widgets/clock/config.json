{
  "version": "1.0",
  "tabs": [
    {
      "id": "general",
      "label": "Clock",
      "description": "Clock widget settings",
      "icon": "preferences-system-time-symbolic",
      "groups": [
        {
          "id": "clock",
          "label": "Clock settings",
          "description": "",
          "fields": [
            {
              "id": "format24h",
              "label": "24-hour format",
              "description": "Show time as 14:30 instead of 2:30 PM",
              "dataType": "boolean",
              "fieldType": "switch",
              "default": true
            },
            {
              "id": "showSeconds",
              "label": "Show seconds",
              "description": "Tick every second instead of every minute",
              "dataType": "boolean",
              "fieldType": "switch",
              "default": false
            },
            {
              "id": "showDate",
              "label": "Show date",
              "description": "Display the date below the time",
              "dataType": "boolean",
              "fieldType": "switch",
              "default": true
            },
            {
              "id": "fontSize",
              "label": "Font size",
              "description": "Size of the time text, in pixels",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 32,
              "min": 10,
              "max": 96,
              "step": 1,
              "suffix": "px"
            }
          ]
        }
      ]
    },
    {
      "id": "shadow",
      "label": "Shadow",
      "description": "Drop shadow behind this widget.",
      "groups": [
        {
          "id": "shadow",
          "label": "Shadow effect",
          "description": "Off by default. Default color is black at 30% transparency.",
          "fields": [
            {
              "id": "shadowEnabled",
              "label": "Enable shadow",
              "description": "Add a drop shadow behind this widget",
              "dataType": "boolean",
              "fieldType": "switch",
              "default": false
            },
            {
              "id": "shadowColor",
              "label": "Shadow color",
              "description": "",
              "dataType": "string",
              "fieldType": "colorpicker",
              "default": "#000000",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowOpacity",
              "label": "Shadow transparency",
              "description": "Shadow opacity, 0-100%",
              "dataType": "integer",
              "fieldType": "slider",
              "default": 30,
              "min": 0,
              "max": 100,
              "step": 1,
              "suffix": "%",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowAngle",
              "label": "Shadow angle",
              "description": "Direction of the shadow in degrees (0 = right, 90 = down, 180 = left, 270 = up)",
              "dataType": "integer",
              "fieldType": "slider",
              "default": 90,
              "min": 0,
              "max": 360,
              "step": 1,
              "suffix": "°",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowDistance",
              "label": "Shadow distance",
              "description": "How far the shadow is offset, in pixels",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 6,
              "min": 0,
              "max": 60,
              "step": 1,
              "suffix": "px",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowBlur",
              "label": "Shadow blur",
              "description": "Blur radius, in pixels",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 16,
              "min": 0,
              "max": 100,
              "step": 1,
              "suffix": "px",
              "visibleIf": "shadowEnabled"
            }
          ]
        }
      ]
    }
  ]
}
