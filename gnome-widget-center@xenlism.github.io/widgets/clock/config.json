{
  "version": "1.0",
  "tabs": [
    {
      "id": "general",
      "label": "Clock",
      "description": "Clock widget settings",
      "icon": "preferences-system-time-symbolic",
      "groups": [
        {
          "id": "clock",
          "label": "Clock settings",
          "description": "",
          "fields": [
            {
              "id": "format24h",
              "label": "24-hour format",
              "description": "Show time as 14:30 instead of 2:30 PM",
              "dataType": "boolean",
              "fieldType": "switch",
              "default": true
            },
            {
              "id": "showSeconds",
              "label": "Show seconds",
              "description": "Tick every second instead of every minute",
              "dataType": "boolean",
              "fieldType": "switch",
              "default": false
            },
            {
              "id": "showDate",
              "label": "Show date",
              "description": "Display the date below the time",
              "dataType": "boolean",
              "fieldType": "switch",
              "default": true
            },
            {
              "id": "fontSize",
              "label": "Font size",
              "description": "Size of the time text, in pixels",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 32,
              "min": 10,
              "max": 96,
              "step": 1,
              "suffix": "px"
            }
          ]
        }
      ]
    }
  ]
}
