{
    "version": "1.0",
    "tabs": [
        {
            "id": "general",
            "label": "Daily Quote",
            "description": "Quote text and rotation settings",
            "icon": "accessories-text-editor-symbolic",
            "groups": [
                {
                    "id": "text",
                    "label": "Text",
                    "description": "",
                    "fields": [
                        {
                            "id": "fontSize",
                            "label": "Font size",
                            "description": "Size of the quote text, in pixels",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 18,
                            "min": 12,
                            "max": 48,
                            "step": 1,
                            "suffix": "px"
                        },
                        {
                            "id": "textColor",
                            "label": "Text color",
                            "description": "Color of the quote text",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "default": "#ffffff"
                        }
                    ]
                },
                {
                    "id": "card",
                    "label": "Card",
                    "description": "",
                    "fields": [
                        {
                            "id": "backgroundColor",
                            "label": "Background color",
                            "description": "Background color of the card",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#1c1f26F5"
                        }
                    ]
                },
                {
                    "id": "rotation",
                    "label": "Rotation",
                    "description": "",
                    "fields": [
                        {
                            "id": "autoRotate",
                            "label": "Auto-rotate",
                            "description": "Pick a new random quote automatically. When off, the current quote stays until you reopen the widget.",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": true
                        },
                        {
                            "id": "refreshInterval",
                            "label": "Rotate every",
                            "description": "How often to pick a new random quote",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 30,
                            "min": 1,
                            "max": 1440,
                            "step": 1,
                            "suffix": "min",
                            "visibleIf": "autoRotate"
                        }
                    ]
                }
            ]
        },
        {
            "id": "shadow",
            "label": "Shadow",
            "description": "Drop shadow behind this widget.",
            "groups": [
                {
                    "id": "shadow",
                    "label": "Shadow effect",
                    "description": "Off by default. Default color is black at 30% transparency.",
                    "fields": [
                        {
                            "id": "shadowAngle",
                            "label": "Shadow angle",
                            "description": "Direction of the shadow in degrees (0 = right, 90 = down, 180 = left, 270 = up)",
                            "dataType": "integer",
                            "fieldType": "slider",
                            "default": 90,
                            "min": 0,
                            "max": 360,
                            "step": 1,
                            "suffix": "\u00b0",
                            "visibleIf": "shadowEnabled"
                        },
                        {
                            "id": "shadowDistance",
                            "label": "Shadow distance",
                            "description": "How far the shadow is offset, in pixels",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 6,
                            "min": 0,
                            "max": 60,
                            "step": 1,
                            "suffix": "px",
                            "visibleIf": "shadowEnabled"
                        }
                    ]
                }
            ]
        }
    ]
}
