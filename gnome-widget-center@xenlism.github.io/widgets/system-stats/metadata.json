{
  "id": "system-stats",
  "name": "System Stats",
  "description": "แสดงสถานะการใช้งาน CPU และ RAM",
  "version": "1.0.0",
  "author": "GNOME Widget Center",
  "api-version": 1,
  "entry": "widget.js",
  "block-type": "1x1",
  "default-position": {
    "x": 16,
    "y": 112,
    "monitor": 0
  },
  "settings": [
    {
      "id": "updateInterval",
      "type": "range",
      "label": "อัปเดตทุก (วินาที)",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 2
    },
    {
      "id": "shadowEnabled",
      "type": "boolean",
      "label": "Enable shadow",
      "default": false
    },
    {
      "id": "shadowColor",
      "type": "color",
      "label": "Shadow color",
      "default": "#000000"
    },
    {
      "id": "shadowOpacity",
      "type": "range",
      "label": "Shadow transparency (%)",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "id": "shadowAngle",
      "type": "range",
      "label": "Shadow angle (degrees)",
      "default": 90,
      "min": 0,
      "max": 360,
      "step": 1
    },
    {
      "id": "shadowDistance",
      "type": "range",
      "label": "Shadow distance (px)",
      "default": 6,
      "min": 0,
      "max": 60,
      "step": 1
    },
    {
      "id": "shadowBlur",
      "type": "range",
      "label": "Shadow blur (px)",
      "default": 16,
      "min": 0,
      "max": 100,
      "step": 1
    }
  ]
}
