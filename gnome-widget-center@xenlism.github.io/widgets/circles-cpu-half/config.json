{
  "version": "1.0",
  "tabs": [
    {
      "id": "general",
      "label": "CPU (Half Ring)",
      "description": "Half-circle CPU ring settings",
      "icon": "utilities-system-monitor-symbolic",
      "groups": [
        {
          "id": "card",
          "label": "Card",
          "description": "",
          "fields": [
            {
              "id": "backgroundColor",
              "label": "Background color",
              "description": "Card background. Use the alpha slider for transparency.",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "alpha": true,
              "default": "#000000a9"
            },
            {
              "id": "cornerRadius",
              "label": "Corner radius",
              "description": "Roundness of the card corners",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 18,
              "min": 0,
              "max": 64,
              "step": 1,
              "suffix": "px"
            }
          ]
        },
        {
          "id": "ring",
          "label": "Ring",
          "description": "",
          "fields": [
            {
              "id": "circleBaseColor",
              "label": "Ring base color (track)",
              "description": "Base/track color drawn behind the CPU progress ring",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "alpha": true,
              "default": "#FFFFFF26"
            },
            {
              "id": "cpuRingColor",
              "label": "CPU ring color",
              "description": "Progress color of the CPU half-ring",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "alpha": true,
              "default": "#33D17AFF"
            },
            {
              "id": "ringThickness",
              "label": "Ring thickness",
              "description": "Stroke width of the half-ring",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 10,
              "min": 3,
              "max": 24,
              "step": 1,
              "suffix": "px"
            },
            {
              "id": "ringSide",
              "label": "Ring side",
              "description": "Which side holds the half-ring. Its curve bends inward toward the text.",
              "dataType": "string",
              "fieldType": "dropdown",
              "default": "right",
              "options": [
                {"value": "right", "label": "Right (curves inward left)"},
                {"value": "left", "label": "Left (curves inward right)"}
              ]
            }
          ]
        },
        {
          "id": "text",
          "label": "Text",
          "description": "",
          "fields": [
            {
              "id": "captionText",
              "label": "Caption text",
              "description": "Small label shown above the percentage",
              "dataType": "string",
              "fieldType": "text",
              "default": "CPU"
            },
            {
              "id": "captionFont",
              "label": "Caption font",
              "description": "Face and size of the caption label",
              "dataType": "string",
              "fieldType": "fontpicker",
              "format": "font",
              "default": "Sans 10"
            },
            {
              "id": "captionColor",
              "label": "Caption color",
              "description": "Color of the caption label",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "alpha": true,
              "default": "#FFFFFFB3"
            },
            {
              "id": "cpuValueFont",
              "label": "CPU text font",
              "description": "Face and size of the CPU percentage number",
              "dataType": "string",
              "fieldType": "fontpicker",
              "format": "font",
              "default": "Sans Bold 24"
            },
            {
              "id": "cpuValueColor",
              "label": "CPU text color",
              "description": "Color of the CPU percentage number",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "alpha": true,
              "default": "#FFFFFFFF"
            }
          ]
        },
        {
          "id": "behavior",
          "label": "Behavior",
          "description": "",
          "fields": [
            {
              "id": "refreshRateSeconds",
              "label": "Refresh rate",
              "description": "How often CPU usage is re-read",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 2,
              "min": 1,
              "max": 60,
              "step": 1,
              "suffix": "s"
            }
          ]
        }
      ]
    },
    {
      "id": "shadow",
      "label": "Shadow",
      "description": "Drop shadow behind this widget.",
      "groups": [
        {
          "id": "shadow",
          "label": "Shadow effect",
          "description": "Off by default. Default color is black at 30% transparency.",
          "fields": [
            {
              "id": "shadowEnabled",
              "label": "Enable shadow",
              "description": "Add a drop shadow behind this widget",
              "dataType": "boolean",
              "fieldType": "switch",
              "default": false
            },
            {
              "id": "shadowColor",
              "label": "Shadow color",
              "description": "",
              "dataType": "string",
              "fieldType": "colorpicker",
              "default": "#000000",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowOpacity",
              "label": "Shadow transparency",
              "description": "Shadow opacity, 0-100%",
              "dataType": "integer",
              "fieldType": "slider",
              "default": 30,
              "min": 0,
              "max": 100,
              "step": 1,
              "suffix": "%",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowAngle",
              "label": "Shadow angle",
              "description": "Direction of the shadow in degrees (0 = right, 90 = down, 180 = left, 270 = up)",
              "dataType": "integer",
              "fieldType": "slider",
              "default": 90,
              "min": 0,
              "max": 360,
              "step": 1,
              "suffix": "°",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowDistance",
              "label": "Shadow distance",
              "description": "How far the shadow is offset, in pixels",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 6,
              "min": 0,
              "max": 60,
              "step": 1,
              "suffix": "px",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowBlur",
              "label": "Shadow blur",
              "description": "Blur radius, in pixels",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 16,
              "min": 0,
              "max": 100,
              "step": 1,
              "suffix": "px",
              "visibleIf": "shadowEnabled"
            }
          ]
        }
      ]
    }
  ]
}
