{
    "version": "1.0",
    "tabs": [
        {
            "id": "general",
            "label": "Stock Markets",
            "description": "Live stock prices, daily change and line graph",
            "icon": "utilities-system-monitor-symbolic",
            "groups": [
                {
                    "id": "stocks",
                    "label": "Symbols",
                    "description": "Which stocks the widget tracks and how it moves between them.",
                    "fields": [
                        {
                            "id": "symbols",
                            "label": "Symbols",
                            "dataType": "list",
                            "fieldType": "list",
                            "description": "Ticker symbols, e.g. AAPL. Thai stocks use .BK (PTT.BK), indices start with ^ (^GSPC). Optional display name after a colon (KBANK.BK:Kasikorn).",
                            "default": [
                                "AAPL",
                                "MSFT",
                                "NVDA"
                            ],
                            "minItems": 1,
                            "maxItems": 8,
                            "item": {
                                "dataType": "string"
                            }
                        },
                        {
                            "id": "defaultSymbol",
                            "label": "Starting symbol",
                            "description": "Symbol shown first, and switched to when you change it (must be in the list above; the .BK suffix is optional)",
                            "dataType": "string",
                            "fieldType": "text",
                            "default": "AAPL"
                        },
                        {
                            "id": "autoRotateSeconds",
                            "label": "Auto-rotate symbols",
                            "description": "Switch to the next symbol every N seconds. 0 turns rotation off.",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 0,
                            "min": 0,
                            "max": 3600,
                            "step": 1,
                            "suffix": "s"
                        },
                        {
                            "id": "showName",
                            "label": "Show company name",
                            "description": "Company name (e.g. Apple Inc.) next to the daily change",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": true
                        }
                    ]
                },
                {
                    "id": "data",
                    "label": "Data & Refresh",
                    "description": "Where prices come from and how often they update.",
                    "fields": [
                        {
                            "id": "provider",
                            "label": "Data provider",
                            "description": "Where prices come from. Auto tries Yahoo, Stooq, CNBC, Nasdaq, then Twelve Data (if a key is set) for each symbol until one answers. Only Twelve Data needs a key.",
                            "dataType": "string",
                            "fieldType": "dropdown",
                            "default": "yahoo",
                            "options": [
                                { "value": "yahoo", "label": "Yahoo Finance (no key, world)" },
                                { "value": "stooq", "label": "Stooq (no key, no Thai stocks)" },
                                { "value": "cnbc", "label": "CNBC (no key, no graph)" },
                                { "value": "nasdaq", "label": "Nasdaq (no key, US only)" },
                                { "value": "twelvedata", "label": "Twelve Data (API key)" },
                                { "value": "auto", "label": "Auto (try all in turn)" }
                            ]
                        },
                        {
                            "id": "twelveDataKey",
                            "label": "Twelve Data API key",
                            "description": "Free key from twelvedata.com. Only used by the Twelve Data provider and by Auto as a last resort. Never exported with theme packs.",
                            "dataType": "string",
                            "fieldType": "password",
                            "default": ""
                        },
                        {
                            "id": "refreshSeconds",
                            "label": "Refresh rate",
                            "description": "How often prices update. Most providers are unofficial, so values under 60 s may be throttled.",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 60,
                            "min": 30,
                            "max": 3600,
                            "step": 1,
                            "suffix": "s"
                        },
                        {
                            "id": "graphRange",
                            "label": "Graph range",
                            "description": "Time span drawn in the line graph (Nasdaq always draws the trading day)",
                            "dataType": "string",
                            "fieldType": "dropdown",
                            "default": "1d",
                            "options": [
                                {
                                    "value": "1d",
                                    "label": "1 day"
                                },
                                {
                                    "value": "5d",
                                    "label": "5 days"
                                },
                                {
                                    "value": "1mo",
                                    "label": "1 month"
                                }
                            ]
                        },
                        {
                            "id": "priceDecimals",
                            "label": "Price decimals",
                            "description": "Auto shows 2 decimals, and 4 for prices below 1",
                            "dataType": "string",
                            "fieldType": "dropdown",
                            "default": "auto",
                            "options": [
                                {
                                    "value": "auto",
                                    "label": "Auto"
                                },
                                {
                                    "value": "0",
                                    "label": "0"
                                },
                                {
                                    "value": "1",
                                    "label": "1"
                                },
                                {
                                    "value": "2",
                                    "label": "2"
                                },
                                {
                                    "value": "3",
                                    "label": "3"
                                },
                                {
                                    "value": "4",
                                    "label": "4"
                                }
                            ]
                        },
                        {
                            "id": "thousandsSeparator",
                            "label": "Thousands separator",
                            "description": "How big numbers are grouped",
                            "dataType": "string",
                            "fieldType": "dropdown",
                            "default": "comma",
                            "options": [
                                {
                                    "value": "comma",
                                    "label": "Comma  1,234.56"
                                },
                                {
                                    "value": "space",
                                    "label": "Space  1 234.56"
                                },
                                {
                                    "value": "none",
                                    "label": "None  1234.56"
                                }
                            ]
                        },
                        {
                            "id": "showCurrencySymbol",
                            "label": "Show currency symbol",
                            "description": "Put $, ฿, € ... in front of the price (taken from the stock's own currency)",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": true
                        }
                    ]
                },
                {
                    "id": "tabs",
                    "label": "Symbol Pill",
                    "description": "The symbol pill in the top-left. Click it to switch symbol.",
                    "fields": [
                        {
                            "id": "tabFont",
                            "label": "Pill font",
                            "description": "Font face and size of the symbol",
                            "dataType": "string",
                            "fieldType": "fontpicker",
                            "format": "font",
                            "default": "Sans Bold 10"
                        },
                        {
                            "id": "tabActiveBgColor",
                            "label": "Pill color",
                            "description": "",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#FFD24AFF",
                            "schemeRole": "ring-3"
                        },
                        {
                            "id": "tabActiveTextColor",
                            "label": "Pill text",
                            "description": "",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#1E2530FF"
                        }
                    ]
                },
                {
                    "id": "price",
                    "label": "Price & Name",
                    "description": "The big price and the company name.",
                    "fields": [
                        {
                            "id": "priceFont",
                            "label": "Price font",
                            "description": "Font face and size of the price",
                            "dataType": "string",
                            "fieldType": "fontpicker",
                            "format": "font",
                            "default": "Sans Bold 26",
                            "fontRole": "text-1"
                        },
                        {
                            "id": "priceColor",
                            "label": "Price color",
                            "description": "",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#FFFFFFFF",
                            "schemeRole": "text-1"
                        },
                        {
                            "id": "nameFont",
                            "label": "Name font",
                            "description": "Font face and size of the company name",
                            "dataType": "string",
                            "fieldType": "fontpicker",
                            "format": "font",
                            "default": "Sans 11"
                        },
                        {
                            "id": "nameColor",
                            "label": "Name color",
                            "description": "",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#AEB8C6FF",
                            "schemeRole": "text-2"
                        },
                        {
                            "id": "showMarketState",
                            "label": "Show market open / closed",
                            "description": "Adds \"· Open\" or \"· Closed\" after the company name",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": true
                        }
                    ]
                },
                {
                    "id": "change",
                    "label": "Daily Change",
                    "description": "The percentage pill.",
                    "fields": [
                        {
                            "id": "changeFont",
                            "label": "Change font",
                            "description": "Font face and size of the percentage",
                            "dataType": "string",
                            "fieldType": "fontpicker",
                            "format": "font",
                            "default": "Sans Bold 10"
                        },
                        {
                            "id": "upColor",
                            "label": "Up color",
                            "description": "Used for a positive daily change (and the graph in trend mode)",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#4ADE80FF",
                            "schemeRole": "ring-2"
                        },
                        {
                            "id": "downColor",
                            "label": "Down color",
                            "description": "Used for a negative daily change (and the graph in trend mode)",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#FF6B6BFF"
                        },
                        {
                            "id": "changePill",
                            "label": "Show change as a pill",
                            "description": "Tinted background behind the percentage",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": true
                        },
                        {
                            "id": "changePillOpacity",
                            "label": "Pill background strength",
                            "description": "",
                            "dataType": "integer",
                            "fieldType": "slider",
                            "default": 25,
                            "min": 0,
                            "max": 100,
                            "step": 1,
                            "suffix": "%"
                        }
                    ]
                },
                {
                    "id": "graph",
                    "label": "Line Graph",
                    "description": "The price history line.",
                    "fields": [
                        {
                            "id": "showGraph",
                            "label": "Show line graph",
                            "description": "",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": true
                        },
                        {
                            "id": "graphLineColorMode",
                            "label": "Line color mode",
                            "description": "Trend follows the up / down colors; Custom always uses the color below",
                            "dataType": "string",
                            "fieldType": "dropdown",
                            "default": "trend",
                            "options": [
                                {
                                    "value": "trend",
                                    "label": "Follow trend (up / down)"
                                },
                                {
                                    "value": "custom",
                                    "label": "Custom color"
                                }
                            ]
                        },
                        {
                            "id": "graphLineColor",
                            "label": "Graph line color",
                            "description": "Used when the line color mode is Custom",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#5AC8FAFF",
                            "schemeRole": "ring-1"
                        },
                        {
                            "id": "graphLineWidth",
                            "label": "Line width",
                            "description": "",
                            "dataType": "integer",
                            "fieldType": "slider",
                            "default": 2,
                            "min": 1,
                            "max": 6,
                            "step": 1,
                            "suffix": "px"
                        },
                        {
                            "id": "graphSmooth",
                            "label": "Smooth curve",
                            "description": "Round the line instead of straight segments",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": false
                        },
                        {
                            "id": "graphFill",
                            "label": "Fill under the line",
                            "description": "Soft gradient below the line",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": false
                        },
                        {
                            "id": "graphFillOpacity",
                            "label": "Fill strength",
                            "description": "",
                            "dataType": "integer",
                            "fieldType": "slider",
                            "default": 25,
                            "min": 0,
                            "max": 100,
                            "step": 1,
                            "suffix": "%"
                        },
                        {
                            "id": "graphHeight",
                            "label": "Graph height",
                            "description": "Height of the graph along the bottom",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 52,
                            "min": 24,
                            "max": 100,
                            "step": 1,
                            "suffix": "px"
                        }
                    ]
                },
                {
                    "id": "card",
                    "label": "Card",
                    "description": "Background and spacing. Corner radius, blur, shadow, border and opacity are on the Appearance tab.",
                    "fields": [
                        {
                            "id": "card-background-color",
                            "label": "Background color",
                            "description": "Card background. Use the alpha slider for transparency.",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#1E2530F5",
                            "schemeRole": "card-background"
                        },
                        {
                            "id": "cardPadding",
                            "label": "Inner padding",
                            "description": "Space between the card edge and its content",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 14,
                            "min": 4,
                            "max": 40,
                            "step": 1,
                            "suffix": "px"
                        }
                    ]
                }
            ]
        }
    ]
}