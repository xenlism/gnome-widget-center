{
  "version": "1.0",
  "tabs": [
    {
      "id": "general",
      "label": "Calendar (Minimal)",
      "description": "Chromeless calendar settings",
      "icon": "x-office-calendar-symbolic",
      "groups": [
        {
          "id": "appearance",
          "label": "Appearance",
          "description": "",
          "fields": [
            {
              "id": "textColor",
              "label": "Day number color",
              "description": "Color of the big day number",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "default": "#1a1a1a"
            },
            {
              "id": "accentColor",
              "label": "Subtitle color",
              "description": "Color of the weekday/month line",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "default": "#6b6b6b"
            },
            {
              "id": "showMonth",
              "label": "Show month",
              "description": "Display the month next to the weekday",
              "dataType": "boolean",
              "fieldType": "switch",
              "default": true
            }
          ]
        }
      ]
    },
    {
      "id": "shadow",
      "label": "Shadow",
      "description": "Drop shadow behind this widget.",
      "groups": [
        {
          "id": "shadow",
          "label": "Shadow effect",
          "description": "Off by default. Default color is black at 30% transparency.",
          "fields": [
            {
              "id": "shadowEnabled",
              "label": "Enable shadow",
              "description": "Add a drop shadow behind this widget",
              "dataType": "boolean",
              "fieldType": "switch",
              "default": false
            },
            {
              "id": "shadowColor",
              "label": "Shadow color",
              "description": "",
              "dataType": "string",
              "fieldType": "colorpicker",
              "default": "#000000",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowOpacity",
              "label": "Shadow transparency",
              "description": "Shadow opacity, 0-100%",
              "dataType": "integer",
              "fieldType": "slider",
              "default": 30,
              "min": 0,
              "max": 100,
              "step": 1,
              "suffix": "%",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowAngle",
              "label": "Shadow angle",
              "description": "Direction of the shadow in degrees (0 = right, 90 = down, 180 = left, 270 = up)",
              "dataType": "integer",
              "fieldType": "slider",
              "default": 90,
              "min": 0,
              "max": 360,
              "step": 1,
              "suffix": "°",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowDistance",
              "label": "Shadow distance",
              "description": "How far the shadow is offset, in pixels",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 6,
              "min": 0,
              "max": 60,
              "step": 1,
              "suffix": "px",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowBlur",
              "label": "Shadow blur",
              "description": "Blur radius, in pixels",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 16,
              "min": 0,
              "max": 100,
              "step": 1,
              "suffix": "px",
              "visibleIf": "shadowEnabled"
            }
          ]
        }
      ]
    }
  ]
}
