{
    "version": "1.0",
    "tabs": [
        {
            "id": "general",
            "label": "Geek Date Stat (Big)",
            "description": "Date + CPU/MEM/DISK card settings",
            "icon": "x-office-calendar-symbolic",
            "groups": [
                {
                    "id": "date-text",
                    "label": "Date text",
                    "description": "The big centered date line, e.g. \"02 AUGUST 2026\".",
                    "fields": [
                        {
                            "id": "dateFont",
                            "label": "Date font",
                            "description": "Font face and size for the date line",
                            "dataType": "string",
                            "fieldType": "fontpicker",
                            "format": "font",
                            "default": "Sans Bold 80"
                        },
                        {
                            "id": "dateColor",
                            "label": "Date color",
                            "description": "Color of the date text",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "default": "#ffffff"
                        }
                    ]
                },
                {
                    "id": "system-text",
                    "label": "System text",
                    "description": "The small centered stats line, e.g. \"CPU 100%  MEM 100%  DISK 100%\".",
                    "fields": [
                        {
                            "id": "systemFont",
                            "label": "System font",
                            "description": "Font face and size for the CPU/MEM/DISK line",
                            "dataType": "string",
                            "fieldType": "fontpicker",
                            "format": "font",
                            "default": "Sans Bold 14"
                        },
                        {
                            "id": "systemColor",
                            "label": "System text color",
                            "description": "Color of the CPU/MEM/DISK line",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "default": "#e6e6e6"
                        },
                        {
                            "id": "updateInterval",
                            "label": "Update interval",
                            "description": "How often CPU/MEM/DISK are re-sampled",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 2,
                            "min": 1,
                            "max": 60,
                            "step": 1,
                            "suffix": "s"
                        },
                        {
                            "id": "diskPath",
                            "label": "Disk path",
                            "description": "Filesystem path used to measure disk usage",
                            "dataType": "string",
                            "fieldType": "text",
                            "default": "/"
                        }
                    ]
                },
                {
                    "id": "layout",
                    "label": "Layout",
                    "description": "Text alignment for the widget's lines.",
                    "fields": [
                        {
                            "id": "textAlign",
                            "label": "Text align",
                            "description": "Horizontal alignment of the text lines inside the card.",
                            "dataType": "string",
                            "fieldType": "dropdown",
                            "default": "center",
                            "options": [
                                {
                                    "value": "left",
                                    "label": "Left"
                                },
                                {
                                    "value": "center",
                                    "label": "Center"
                                },
                                {
                                    "value": "right",
                                    "label": "Right"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "card",
                    "label": "Card",
                    "description": "Card background and shape.",
                    "fields": [
                        {
                            "id": "backgroundColor",
                            "label": "Background color",
                            "description": "Card background color (supports transparency)",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "default": "#FFFFFF00",
                            "alpha": true
                        },
                        {
                            "id": "cornerRadius",
                            "label": "Corner radius",
                            "description": "Roundness of the card's corners",
                            "dataType": "number",
                            "fieldType": "spinbutton",
                            "default": 18,
                            "min": 0,
                            "max": 60,
                            "step": 1,
                            "suffix": "px"
                        }
                    ]
                },
                {
                    "id": "borderOpacity",
                    "label": "Border & Opacity",
                    "description": "",
                    "fields": [
                        {
                            "id": "borderEnabled",
                            "label": "Enable border",
                            "description": "Draw a border around this widget's card",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": false
                        },
                        {
                            "id": "borderColor",
                            "label": "Border color",
                            "description": "",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#FFFFFF33",
                            "visibleIf": "borderEnabled"
                        },
                        {
                            "id": "borderWidth",
                            "label": "Border width",
                            "description": "",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 1,
                            "min": 0,
                            "max": 16,
                            "step": 1,
                            "suffix": "px",
                            "visibleIf": "borderEnabled"
                        },
                        {
                            "id": "opacity",
                            "label": "Opacity",
                            "description": "Fades the entire widget - background, text, icons, everything.",
                            "dataType": "integer",
                            "fieldType": "slider",
                            "default": 100,
                            "min": 0,
                            "max": 100,
                            "step": 1,
                            "suffix": "%"
                        }
                    ]
                }
            ]
        },
        {
            "id": "text-shadow",
            "label": "Text Shadow",
            "description": "Drop shadow drawn under the date/system text itself.",
            "groups": [
                {
                    "id": "text-shadow",
                    "label": "Text shadow effect",
                    "description": "Off by default. Default color is black at 60% transparency.",
                    "fields": [
                        {
                            "id": "textShadowEnabled",
                            "label": "Enable text shadow",
                            "description": "Add a shadow behind the date and system text",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": false
                        },
                        {
                            "id": "textShadowColor",
                            "label": "Text shadow color",
                            "description": "",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "default": "#000000",
                            "visibleIf": "textShadowEnabled"
                        },
                        {
                            "id": "textShadowOpacity",
                            "label": "Text shadow transparency",
                            "description": "Shadow opacity, 0-100%",
                            "dataType": "integer",
                            "fieldType": "slider",
                            "default": 60,
                            "min": 0,
                            "max": 100,
                            "step": 1,
                            "suffix": "%",
                            "visibleIf": "textShadowEnabled"
                        },
                        {
                            "id": "textShadowAngle",
                            "label": "Text shadow angle",
                            "description": "Direction of the shadow in degrees (0 = right, 90 = down, 180 = left, 270 = up)",
                            "dataType": "integer",
                            "fieldType": "slider",
                            "default": 90,
                            "min": 0,
                            "max": 360,
                            "step": 1,
                            "suffix": "°",
                            "visibleIf": "textShadowEnabled"
                        },
                        {
                            "id": "textShadowDistance",
                            "label": "Text shadow distance",
                            "description": "How far the shadow is offset, in pixels",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 2,
                            "min": 0,
                            "max": 30,
                            "step": 1,
                            "suffix": "px",
                            "visibleIf": "textShadowEnabled"
                        },
                        {
                            "id": "textShadowBlur",
                            "label": "Text shadow blur",
                            "description": "Blur radius, in pixels",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 4,
                            "min": 0,
                            "max": 40,
                            "step": 1,
                            "suffix": "px",
                            "visibleIf": "textShadowEnabled"
                        }
                    ]
                }
            ]
        },
        {
            "id": "shadow",
            "label": "Widget Shadow",
            "description": "Drop shadow behind the whole widget card.",
            "groups": [
                {
                    "id": "shadow",
                    "label": "Shadow effect",
                    "description": "Off by default. Default color is black at 30% transparency.",
                    "fields": [
                        {
                            "id": "shadowEnabled",
                            "label": "Enable shadow",
                            "description": "Add a drop shadow behind this widget",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": false
                        },
                        {
                            "id": "shadowColor",
                            "label": "Shadow color",
                            "description": "",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "default": "#000000",
                            "visibleIf": "shadowEnabled"
                        },
                        {
                            "id": "shadowOpacity",
                            "label": "Shadow transparency",
                            "description": "Shadow opacity, 0-100%",
                            "dataType": "integer",
                            "fieldType": "slider",
                            "default": 30,
                            "min": 0,
                            "max": 100,
                            "step": 1,
                            "suffix": "%",
                            "visibleIf": "shadowEnabled"
                        },
                        {
                            "id": "shadowAngle",
                            "label": "Shadow angle",
                            "description": "Direction of the shadow in degrees (0 = right, 90 = down, 180 = left, 270 = up)",
                            "dataType": "integer",
                            "fieldType": "slider",
                            "default": 90,
                            "min": 0,
                            "max": 360,
                            "step": 1,
                            "suffix": "°",
                            "visibleIf": "shadowEnabled"
                        },
                        {
                            "id": "shadowDistance",
                            "label": "Shadow distance",
                            "description": "How far the shadow is offset, in pixels",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 6,
                            "min": 0,
                            "max": 60,
                            "step": 1,
                            "suffix": "px",
                            "visibleIf": "shadowEnabled"
                        },
                        {
                            "id": "shadowBlur",
                            "label": "Shadow blur",
                            "description": "Blur radius, in pixels",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 16,
                            "min": 0,
                            "max": 100,
                            "step": 1,
                            "suffix": "px",
                            "visibleIf": "shadowEnabled"
                        }
                    ]
                }
            ]
        }
    ]
}