{
  "version": "1.0",
  "tabs": [
    {
      "id": "general",
      "label": "Media Player (Square)",
      "description": "1x1 Now Playing card settings",
      "icon": "multimedia-player-symbolic",
      "groups": [
        {
          "id": "appearance",
          "label": "Appearance",
          "description": "",
          "fields": [
            {
              "id": "backgroundColor",
              "label": "Background color",
              "description": "Fill color behind the album cover's frame",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "default": "#000000F5"
            },
            {
              "id": "cornerRadius",
              "label": "Corner radius",
              "description": "Roundness of the card's corners",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 18,
              "min": 0,
              "max": 80,
              "step": 1,
              "suffix": "px"
            },
            {
              "id": "infoFont",
              "label": "Track info font",
              "description": "Font used for the title, album and artist lines overlaid on the cover",
              "dataType": "string",
              "fieldType": "fontpicker",
              "format": "font",
              "default": "Sans Bold 13"
            },
            {
              "id": "infoColor",
              "label": "Track info color",
              "description": "Color of the title, album and artist lines",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "default": "#FFFFFFFF"
            },
            {
              "id": "buttonColor",
              "label": "Button color",
              "description": "Color of the Play/Previous/Next icons and their hover backdrop",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "default": "#FFFFFFFF"
            }
          ]
        },
        {
          "id": "launch",
          "label": "Launch on click",
          "description": "Clicking the cover raises the running player, or launches this app if none is running yet. The Play button does the same on its very first click.",
          "fields": [
            {
              "id": "desktopFilePath",
              "label": "App to launch",
              "description": "Application (.desktop file) launched when no MPRIS player is running",
              "dataType": "string",
              "fieldType": "filepicker",
              "format": "file",
              "default": "",
              "filters": [
                "*.desktop"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "shadow",
      "label": "Shadow",
      "description": "Drop shadow behind this widget.",
      "groups": [
        {
          "id": "shadow",
          "label": "Shadow effect",
          "description": "Off by default. Default color is black at 30% transparency.",
          "fields": [
            {
              "id": "shadowEnabled",
              "label": "Enable shadow",
              "description": "Add a drop shadow behind this widget",
              "dataType": "boolean",
              "fieldType": "switch",
              "default": false
            },
            {
              "id": "shadowColor",
              "label": "Shadow color",
              "description": "",
              "dataType": "string",
              "fieldType": "colorpicker",
              "default": "#000000",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowOpacity",
              "label": "Shadow transparency",
              "description": "Shadow opacity, 0-100%",
              "dataType": "integer",
              "fieldType": "slider",
              "default": 30,
              "min": 0,
              "max": 100,
              "step": 1,
              "suffix": "%",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowAngle",
              "label": "Shadow angle",
              "description": "Direction of the shadow in degrees (0 = right, 90 = down, 180 = left, 270 = up)",
              "dataType": "integer",
              "fieldType": "slider",
              "default": 90,
              "min": 0,
              "max": 360,
              "step": 1,
              "suffix": "°",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowDistance",
              "label": "Shadow distance",
              "description": "How far the shadow is offset, in pixels",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 6,
              "min": 0,
              "max": 60,
              "step": 1,
              "suffix": "px",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowBlur",
              "label": "Shadow blur",
              "description": "Blur radius, in pixels",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 16,
              "min": 0,
              "max": 100,
              "step": 1,
              "suffix": "px",
              "visibleIf": "shadowEnabled"
            }
          ]
        }
      ]
    }
  ]
}
