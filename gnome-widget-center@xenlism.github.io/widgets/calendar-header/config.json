{
  "version": "1.0",
  "tabs": [
    {
      "id": "general",
      "label": "Calendar (Header)",
      "description": "Two-tone calendar with a colored header band",
      "icon": "x-office-calendar-symbolic",
      "groups": [
        {
          "id": "colors",
          "label": "Colors",
          "description": "",
          "fields": [
            {
              "id": "headerColor",
              "label": "Header background",
              "description": "Band behind month/weekday",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "default": "#2563eb"
            },
            {
              "id": "headerTextColor",
              "label": "Header text",
              "description": "Month/weekday text color",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "default": "#ffffff"
            },
            {
              "id": "bodyColor",
              "label": "Body background",
              "description": "Panel behind the day number",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "default": "#ffffff"
            },
            {
              "id": "dayColor",
              "label": "Day number color",
              "description": "Color of the day number",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "default": "#1a1a1a"
            }
          ]
        },
        {
          "id": "borderOpacity",
          "label": "Border & Opacity",
          "description": "Border wraps the whole card (header + body); opacity fades the entire widget.",
          "fields": [
            {
              "id": "borderEnabled",
              "label": "Enable border",
              "description": "Draw a border around this widget's card",
              "dataType": "boolean",
              "fieldType": "switch",
              "default": false
            },
            {
              "id": "borderColor",
              "label": "Border color",
              "description": "",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "alpha": true,
              "default": "#FFFFFF33",
              "visibleIf": "borderEnabled"
            },
            {
              "id": "borderWidth",
              "label": "Border width",
              "description": "",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 1,
              "min": 0,
              "max": 16,
              "step": 1,
              "suffix": "px",
              "visibleIf": "borderEnabled"
            },
            {
              "id": "opacity",
              "label": "Opacity",
              "description": "Fades the entire widget - background, text, icons, everything.",
              "dataType": "integer",
              "fieldType": "slider",
              "default": 100,
              "min": 0,
              "max": 100,
              "step": 1,
              "suffix": "%"
            }
          ]
        }
      ]
    },
    {
      "id": "shadow",
      "label": "Shadow",
      "description": "Drop shadow behind this widget.",
      "groups": [
        {
          "id": "shadow",
          "label": "Shadow effect",
          "description": "Off by default. Default color is black at 30% transparency.",
          "fields": [
            {
              "id": "shadowEnabled",
              "label": "Enable shadow",
              "description": "Add a drop shadow behind this widget",
              "dataType": "boolean",
              "fieldType": "switch",
              "default": false
            },
            {
              "id": "shadowColor",
              "label": "Shadow color",
              "description": "",
              "dataType": "string",
              "fieldType": "colorpicker",
              "default": "#000000",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowOpacity",
              "label": "Shadow transparency",
              "description": "Shadow opacity, 0-100%",
              "dataType": "integer",
              "fieldType": "slider",
              "default": 30,
              "min": 0,
              "max": 100,
              "step": 1,
              "suffix": "%",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowAngle",
              "label": "Shadow angle",
              "description": "Direction of the shadow in degrees (0 = right, 90 = down, 180 = left, 270 = up)",
              "dataType": "integer",
              "fieldType": "slider",
              "default": 90,
              "min": 0,
              "max": 360,
              "step": 1,
              "suffix": "°",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowDistance",
              "label": "Shadow distance",
              "description": "How far the shadow is offset, in pixels",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 6,
              "min": 0,
              "max": 60,
              "step": 1,
              "suffix": "px",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowBlur",
              "label": "Shadow blur",
              "description": "Blur radius, in pixels",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 16,
              "min": 0,
              "max": 100,
              "step": 1,
              "suffix": "px",
              "visibleIf": "shadowEnabled"
            }
          ]
        }
      ]
    }
  ]
}
