{
    "version": "1.0",
    "tabs": [
        {
            "id": "general",
            "label": "Calendar (Header)",
            "description": "Two-tone calendar with a colored header band",
            "icon": "x-office-calendar-symbolic",
            "groups": [
                {
                    "id": "colors",
                    "label": "Colors",
                    "description": "",
                    "fields": [
                        {
                            "id": "headerColor",
                            "label": "Header background",
                            "description": "Band behind month/weekday",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "default": "#2563eb"
                        },
                        {
                            "id": "headerTextColor",
                            "label": "Header text",
                            "description": "Month/weekday text color",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "default": "#ffffff"
                        },
                        {
                            "id": "bodyColor",
                            "label": "Body background",
                            "description": "Panel behind the day number",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "default": "#ffffff"
                        },
                        {
                            "id": "dayColor",
                            "label": "Day number color",
                            "description": "Color of the day number",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "default": "#1a1a1a"
                        }
                    ]
                }
            ]
        },
        {
            "id": "shadow",
            "label": "Shadow",
            "description": "Drop shadow behind this widget.",
            "groups": [
                {
                    "id": "shadow",
                    "label": "Shadow effect",
                    "description": "Off by default. Default color is black at 30% transparency.",
                    "fields": [
                        {
                            "id": "shadowAngle",
                            "label": "Shadow angle",
                            "description": "Direction of the shadow in degrees (0 = right, 90 = down, 180 = left, 270 = up)",
                            "dataType": "integer",
                            "fieldType": "slider",
                            "default": 90,
                            "min": 0,
                            "max": 360,
                            "step": 1,
                            "suffix": "°",
                            "visibleIf": "shadowEnabled"
                        },
                        {
                            "id": "shadowDistance",
                            "label": "Shadow distance",
                            "description": "How far the shadow is offset, in pixels",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 6,
                            "min": 0,
                            "max": 60,
                            "step": 1,
                            "suffix": "px",
                            "visibleIf": "shadowEnabled"
                        }
                    ]
                }
            ]
        }
    ]
}