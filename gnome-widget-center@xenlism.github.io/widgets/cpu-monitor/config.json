{
  "version": "1.0",
  "tabs": [
    {
      "id": "general",
      "label": "CPU Monitor",
      "description": "CPU usage card settings",
      "icon": "utilities-system-monitor-symbolic",
      "groups": [
        {
          "id": "text",
          "label": "Text",
          "description": "",
          "fields": [
            {
              "id": "fontDesc",
              "label": "Font",
              "description": "Face and size used for the big percentage number and the CPU label",
              "dataType": "string",
              "fieldType": "fontpicker",
              "default": "Sans Bold 34"
            },
            {
              "id": "fontColor",
              "label": "Font color",
              "description": "Color of the percentage number and label text",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "alpha": true,
              "default": "#FFFFFFFF"
            }
          ]
        },
        {
          "id": "graph",
          "label": "Graph",
          "description": "",
          "fields": [
            {
              "id": "graphLineColor",
              "label": "Graph line color",
              "description": "Color of the sparkline history line",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "alpha": true,
              "default": "#5AC8FAFF"
            },
            {
              "id": "graphBaseColor",
              "label": "Graph base color",
              "description": "Background color of the strip the graph is drawn on",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "alpha": true,
              "default": "#FFFFFF12"
            }
          ]
        },
        {
          "id": "appearance",
          "label": "Appearance",
          "description": "",
          "fields": [
            {
              "id": "backgroundColor",
              "label": "Background color",
              "description": "Card background. Use the alpha slider for transparency.",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "alpha": true,
              "default": "#000000FF"
            },
            {
              "id": "cornerRadius",
              "label": "Corner radius",
              "description": "Roundness of the card corners",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 18,
              "min": 0,
              "max": 64,
              "step": 1,
              "suffix": "px"
            }
          ]
        },
        {
          "id": "behavior",
          "label": "Behavior",
          "description": "",
          "fields": [
            {
              "id": "refreshRateSeconds",
              "label": "Refresh rate",
              "description": "How often the CPU reading and graph update",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 3,
              "min": 1,
              "max": 60,
              "step": 1,
              "suffix": "s"
            },
            {
              "id": "launchAppPath",
              "label": "Click to launch",
              "description": "Pick a .desktop file to launch when this card is clicked. Leave empty to disable.",
              "dataType": "string",
              "fieldType": "filepicker",
              "filters": [
                "*.desktop"
              ],
              "default": ""
            }
          ]
        }
      ]
    },
    {
      "id": "shadow",
      "label": "Shadow",
      "description": "Drop shadow behind this widget.",
      "groups": [
        {
          "id": "shadow",
          "label": "Shadow effect",
          "description": "Off by default. Default color is black at 30% transparency.",
          "fields": [
            {
              "id": "shadowEnabled",
              "label": "Enable shadow",
              "description": "Add a drop shadow behind this widget",
              "dataType": "boolean",
              "fieldType": "switch",
              "default": false
            },
            {
              "id": "shadowColor",
              "label": "Shadow color",
              "description": "",
              "dataType": "string",
              "fieldType": "colorpicker",
              "default": "#000000",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowOpacity",
              "label": "Shadow transparency",
              "description": "Shadow opacity, 0-100%",
              "dataType": "integer",
              "fieldType": "slider",
              "default": 30,
              "min": 0,
              "max": 100,
              "step": 1,
              "suffix": "%",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowAngle",
              "label": "Shadow angle",
              "description": "Direction of the shadow in degrees (0 = right, 90 = down, 180 = left, 270 = up)",
              "dataType": "integer",
              "fieldType": "slider",
              "default": 90,
              "min": 0,
              "max": 360,
              "step": 1,
              "suffix": "°",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowDistance",
              "label": "Shadow distance",
              "description": "How far the shadow is offset, in pixels",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 6,
              "min": 0,
              "max": 60,
              "step": 1,
              "suffix": "px",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowBlur",
              "label": "Shadow blur",
              "description": "Blur radius, in pixels",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 16,
              "min": 0,
              "max": 100,
              "step": 1,
              "suffix": "px",
              "visibleIf": "shadowEnabled"
            }
          ]
        }
      ]
    }
  ]
}
