{
    "version": "1.0",
    "tabs": [
        {
            "id": "general",
            "label": "Memory (Half Ring)",
            "description": "Half-circle Memory ring settings",
            "icon": "utilities-system-monitor-symbolic",
            "groups": [
                {
                    "id": "card",
                    "label": "Card",
                    "description": "",
                    "fields": [
                        {
                            "id": "backgroundColor",
                            "label": "Background color",
                            "description": "Card background. Use the alpha slider for transparency.",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#00000000"
                        }
                    ]
                },
                {
                    "id": "ring",
                    "label": "Ring",
                    "description": "",
                    "fields": [
                        {
                            "id": "circleBaseColor",
                            "label": "Ring base color (track)",
                            "description": "Base/track color drawn behind the Memory progress ring",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#FFFFFF26"
                        },
                        {
                            "id": "memRingColor",
                            "label": "Memory ring color",
                            "description": "Progress color of the Memory half-ring",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#3584E4FF"
                        },
                        {
                            "id": "ringThickness",
                            "label": "Ring thickness",
                            "description": "Stroke width of the half-ring",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 10,
                            "min": 3,
                            "max": 24,
                            "step": 1,
                            "suffix": "px"
                        },
                        {
                            "id": "ringSide",
                            "label": "Ring side",
                            "description": "Which side holds the half-ring. Its curve bends inward toward the text.",
                            "dataType": "string",
                            "fieldType": "dropdown",
                            "default": "right",
                            "options": [
                                {
                                    "value": "right",
                                    "label": "Right (curves inward left)"
                                },
                                {
                                    "value": "left",
                                    "label": "Left (curves inward right)"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "text",
                    "label": "Text",
                    "description": "",
                    "fields": [
                        {
                            "id": "captionText",
                            "label": "Caption text",
                            "description": "Small label shown above the percentage",
                            "dataType": "string",
                            "fieldType": "text",
                            "default": "MEM"
                        },
                        {
                            "id": "captionFont",
                            "label": "Caption font",
                            "description": "Face and size of the caption label",
                            "dataType": "string",
                            "fieldType": "fontpicker",
                            "format": "font",
                            "default": "Sans 10"
                        },
                        {
                            "id": "captionColor",
                            "label": "Caption color",
                            "description": "Color of the caption label",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#FFFFFFB3"
                        },
                        {
                            "id": "memValueFont",
                            "label": "Memory text font",
                            "description": "Face and size of the Memory percentage number",
                            "dataType": "string",
                            "fieldType": "fontpicker",
                            "format": "font",
                            "default": "Sans Bold 24"
                        },
                        {
                            "id": "memValueColor",
                            "label": "Memory text color",
                            "description": "Color of the Memory percentage number",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#FFFFFFFF"
                        }
                    ]
                },
                {
                    "id": "behavior",
                    "label": "Behavior",
                    "description": "",
                    "fields": [
                        {
                            "id": "refreshRateSeconds",
                            "label": "Refresh rate",
                            "description": "How often Memory usage is re-read",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 2,
                            "min": 1,
                            "max": 60,
                            "step": 1,
                            "suffix": "s"
                        }
                    ]
                }
            ]
        },
        {
            "id": "shadow",
            "label": "Shadow",
            "description": "Drop shadow behind this widget.",
            "groups": [
                {
                    "id": "shadow",
                    "label": "Shadow effect",
                    "description": "Off by default. Default color is black at 30% transparency.",
                    "fields": [
                        {
                            "id": "shadowAngle",
                            "label": "Shadow angle",
                            "description": "Direction of the shadow in degrees (0 = right, 90 = down, 180 = left, 270 = up)",
                            "dataType": "integer",
                            "fieldType": "slider",
                            "default": 90,
                            "min": 0,
                            "max": 360,
                            "step": 1,
                            "suffix": "\u00b0",
                            "visibleIf": "shadowEnabled"
                        },
                        {
                            "id": "shadowDistance",
                            "label": "Shadow distance",
                            "description": "How far the shadow is offset, in pixels",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 6,
                            "min": 0,
                            "max": 60,
                            "step": 1,
                            "suffix": "px",
                            "visibleIf": "shadowEnabled"
                        }
                    ]
                }
            ]
        }
    ]
}
