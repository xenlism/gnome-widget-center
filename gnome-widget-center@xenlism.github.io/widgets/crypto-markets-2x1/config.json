{
    "version": "1.0",
    "tabs": [
        {
            "id": "general",
            "label": "Crypto Markets",
            "description": "Live crypto prices, 24h change and line graph",
            "icon": "utilities-system-monitor-symbolic",
            "groups": [
                {
                    "id": "coins",
                    "label": "Coins",
                    "description": "Which coins the widget tracks and how it moves between them.",
                    "fields": [
                        {
                            "id": "coins",
                            "label": "Coins",
                            "dataType": "list",
                            "fieldType": "list",
                            "description": "Ticker symbols, e.g. BTC. For a coin that is not built in, write SYMBOL:coingecko-id (e.g. KAS:kaspa).",
                            "default": [
                                "BTC",
                                "ETH",
                                "SOL"
                            ],
                            "minItems": 1,
                            "maxItems": 12,
                            "item": {
                                "dataType": "string"
                            }
                        },
                        {
                            "id": "defaultCoin",
                            "label": "Starting coin",
                            "description": "Symbol shown first when the widget loads (must be in the list above)",
                            "dataType": "string",
                            "fieldType": "text",
                            "default": "BTC"
                        },
                        {
                            "id": "showTabs",
                            "label": "Show coin tabs",
                            "description": "Clickable BTC / ETH / SOL pills in the header",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": true
                        },
                        {
                            "id": "autoRotateSeconds",
                            "label": "Auto-rotate coins",
                            "description": "Switch to the next coin every N seconds. 0 turns rotation off.",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 0,
                            "min": 0,
                            "max": 3600,
                            "step": 1,
                            "suffix": "s"
                        },
                        {
                            "id": "showName",
                            "label": "Show coin name",
                            "description": "Full coin name (e.g. Bitcoin) next to the 24h change",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": true
                        }
                    ]
                },
                {
                    "id": "data",
                    "label": "Data & Refresh",
                    "description": "Where prices come from and how often they update.",
                    "fields": [
                        {
                            "id": "provider",
                            "label": "Data provider",
                            "description": "CoinGecko needs no key and includes a 7-day graph. CoinMarketCap needs an API key; its graph is built from prices collected while the widget runs.",
                            "dataType": "string",
                            "fieldType": "dropdown",
                            "default": "coingecko",
                            "options": [
                                {
                                    "value": "coingecko",
                                    "label": "CoinGecko (no key)"
                                },
                                {
                                    "value": "coinmarketcap",
                                    "label": "CoinMarketCap (API key)"
                                }
                            ]
                        },
                        {
                            "id": "cmcApiKey",
                            "label": "CoinMarketCap API key",
                            "description": "Only used when the provider is CoinMarketCap. Never exported with theme packs.",
                            "dataType": "string",
                            "fieldType": "password",
                            "default": ""
                        },
                        {
                            "id": "cmcEndpoint",
                            "label": "CoinMarketCap endpoint",
                            "description": "Latest-quotes URL. The widget appends symbol=...&convert=... itself.",
                            "dataType": "string",
                            "fieldType": "text",
                            "default": "https://pro-api.coinmarketcap.com/v2/cryptocurrency/quotes/latest"
                        },
                        {
                            "id": "currency",
                            "label": "Currency",
                            "description": "Fiat currency prices are quoted in",
                            "dataType": "string",
                            "fieldType": "dropdown",
                            "default": "USD",
                            "options": [
                                {
                                    "value": "USD",
                                    "label": "USD"
                                },
                                {
                                    "value": "THB",
                                    "label": "THB"
                                },
                                {
                                    "value": "EUR",
                                    "label": "EUR"
                                },
                                {
                                    "value": "GBP",
                                    "label": "GBP"
                                },
                                {
                                    "value": "JPY",
                                    "label": "JPY"
                                },
                                {
                                    "value": "CNY",
                                    "label": "CNY"
                                },
                                {
                                    "value": "KRW",
                                    "label": "KRW"
                                },
                                {
                                    "value": "AUD",
                                    "label": "AUD"
                                }
                            ]
                        },
                        {
                            "id": "refreshSeconds",
                            "label": "Refresh rate",
                            "description": "How often prices update. CoinGecko's free tier limits requests, so values under 60 s may be throttled.",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 60,
                            "min": 30,
                            "max": 3600,
                            "step": 1,
                            "suffix": "s"
                        },
                        {
                            "id": "graphRange",
                            "label": "Graph range",
                            "description": "Time span drawn in the line graph",
                            "dataType": "string",
                            "fieldType": "dropdown",
                            "default": "24h",
                            "options": [
                                {
                                    "value": "24h",
                                    "label": "24 hours"
                                },
                                {
                                    "value": "7d",
                                    "label": "7 days"
                                }
                            ]
                        },
                        {
                            "id": "priceDecimals",
                            "label": "Price decimals",
                            "description": "Auto shows whole numbers for large prices and more digits for small ones",
                            "dataType": "string",
                            "fieldType": "dropdown",
                            "default": "auto",
                            "options": [
                                {
                                    "value": "auto",
                                    "label": "Auto"
                                },
                                {
                                    "value": "0",
                                    "label": "0"
                                },
                                {
                                    "value": "1",
                                    "label": "1"
                                },
                                {
                                    "value": "2",
                                    "label": "2"
                                },
                                {
                                    "value": "3",
                                    "label": "3"
                                },
                                {
                                    "value": "4",
                                    "label": "4"
                                },
                                {
                                    "value": "5",
                                    "label": "5"
                                },
                                {
                                    "value": "6",
                                    "label": "6"
                                }
                            ]
                        },
                        {
                            "id": "thousandsSeparator",
                            "label": "Thousands separator",
                            "description": "How big numbers are grouped",
                            "dataType": "string",
                            "fieldType": "dropdown",
                            "default": "space",
                            "options": [
                                {
                                    "value": "space",
                                    "label": "Space  27 978 263"
                                },
                                {
                                    "value": "comma",
                                    "label": "Comma  27,978,263"
                                },
                                {
                                    "value": "none",
                                    "label": "None  27978263"
                                }
                            ]
                        },
                        {
                            "id": "showCurrencySymbol",
                            "label": "Show currency symbol",
                            "description": "Put $, ฿, € ... in front of the price",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": false
                        }
                    ]
                },
                {
                    "id": "title",
                    "label": "Header",
                    "description": "The \"MARKETS\" title row.",
                    "fields": [
                        {
                            "id": "showTitle",
                            "label": "Show header title",
                            "description": "",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": true
                        },
                        {
                            "id": "titleText",
                            "label": "Title text",
                            "description": "",
                            "dataType": "string",
                            "fieldType": "text",
                            "default": "MARKETS"
                        },
                        {
                            "id": "titleFont",
                            "label": "Title font",
                            "description": "Font face and size of the title",
                            "dataType": "string",
                            "fieldType": "fontpicker",
                            "format": "font",
                            "default": "Sans Bold 11"
                        },
                        {
                            "id": "titleColor",
                            "label": "Title color",
                            "description": "",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#FFFFFFFF",
                            "schemeRole": "text-1"
                        },
                        {
                            "id": "dotColor",
                            "label": "Title dot color",
                            "description": "The small dot before the title",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#FFD24AFF",
                            "schemeRole": "ring-3"
                        }
                    ]
                },
                {
                    "id": "tabs",
                    "label": "Coin Tabs",
                    "description": "The pill buttons that pick the coin.",
                    "fields": [
                        {
                            "id": "tabFont",
                            "label": "Tab font",
                            "description": "Font face and size on the pills",
                            "dataType": "string",
                            "fieldType": "fontpicker",
                            "format": "font",
                            "default": "Sans Bold 9"
                        },
                        {
                            "id": "tabActiveBgColor",
                            "label": "Active tab color",
                            "description": "",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#FFD24AFF",
                            "schemeRole": "ring-3"
                        },
                        {
                            "id": "tabActiveTextColor",
                            "label": "Active tab text",
                            "description": "",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#1E2530FF"
                        },
                        {
                            "id": "tabInactiveBgColor",
                            "label": "Inactive tab color",
                            "description": "",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#394350FF"
                        },
                        {
                            "id": "tabInactiveTextColor",
                            "label": "Inactive tab text",
                            "description": "",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#C3CCD8FF",
                            "schemeRole": "text-2"
                        }
                    ]
                },
                {
                    "id": "price",
                    "label": "Price & Name",
                    "description": "The big price and the coin name.",
                    "fields": [
                        {
                            "id": "priceFont",
                            "label": "Price font",
                            "description": "Font face and size of the price",
                            "dataType": "string",
                            "fieldType": "fontpicker",
                            "format": "font",
                            "default": "Sans Bold 28",
                            "fontRole": "text-1"
                        },
                        {
                            "id": "priceColor",
                            "label": "Price color",
                            "description": "",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#FFFFFFFF",
                            "schemeRole": "text-1"
                        },
                        {
                            "id": "nameFont",
                            "label": "Name font",
                            "description": "Font face and size of the coin name",
                            "dataType": "string",
                            "fieldType": "fontpicker",
                            "format": "font",
                            "default": "Sans 11"
                        },
                        {
                            "id": "nameColor",
                            "label": "Name color",
                            "description": "",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#AEB8C6FF",
                            "schemeRole": "text-2"
                        }
                    ]
                },
                {
                    "id": "change",
                    "label": "24h Change",
                    "description": "The percentage pill.",
                    "fields": [
                        {
                            "id": "changeFont",
                            "label": "Change font",
                            "description": "Font face and size of the percentage",
                            "dataType": "string",
                            "fieldType": "fontpicker",
                            "format": "font",
                            "default": "Sans Bold 10"
                        },
                        {
                            "id": "upColor",
                            "label": "Up color",
                            "description": "Used for a positive 24h change (and the graph in trend mode)",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#4ADE80FF",
                            "schemeRole": "ring-2"
                        },
                        {
                            "id": "downColor",
                            "label": "Down color",
                            "description": "Used for a negative 24h change (and the graph in trend mode)",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#FF6B6BFF"
                        },
                        {
                            "id": "changePill",
                            "label": "Show change as a pill",
                            "description": "Tinted background behind the percentage",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": true
                        },
                        {
                            "id": "changePillOpacity",
                            "label": "Pill background strength",
                            "description": "",
                            "dataType": "integer",
                            "fieldType": "slider",
                            "default": 25,
                            "min": 0,
                            "max": 100,
                            "step": 1,
                            "suffix": "%"
                        }
                    ]
                },
                {
                    "id": "graph",
                    "label": "Line Graph",
                    "description": "The price history line.",
                    "fields": [
                        {
                            "id": "showGraph",
                            "label": "Show line graph",
                            "description": "",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": true
                        },
                        {
                            "id": "graphLineColorMode",
                            "label": "Line color mode",
                            "description": "Trend follows the up / down colors; Custom always uses the color below",
                            "dataType": "string",
                            "fieldType": "dropdown",
                            "default": "trend",
                            "options": [
                                {
                                    "value": "trend",
                                    "label": "Follow trend (up / down)"
                                },
                                {
                                    "value": "custom",
                                    "label": "Custom color"
                                }
                            ]
                        },
                        {
                            "id": "graphLineColor",
                            "label": "Graph line color",
                            "description": "Used when the line color mode is Custom",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#5AC8FAFF",
                            "schemeRole": "ring-1"
                        },
                        {
                            "id": "graphLineWidth",
                            "label": "Line width",
                            "description": "",
                            "dataType": "integer",
                            "fieldType": "slider",
                            "default": 2,
                            "min": 1,
                            "max": 6,
                            "step": 1,
                            "suffix": "px"
                        },
                        {
                            "id": "graphSmooth",
                            "label": "Smooth curve",
                            "description": "Round the line instead of straight segments",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": false
                        },
                        {
                            "id": "graphFill",
                            "label": "Fill under the line",
                            "description": "Soft gradient below the line",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": false
                        },
                        {
                            "id": "graphFillOpacity",
                            "label": "Fill strength",
                            "description": "",
                            "dataType": "integer",
                            "fieldType": "slider",
                            "default": 25,
                            "min": 0,
                            "max": 100,
                            "step": 1,
                            "suffix": "%"
                        },
                        {
                            "id": "graphWidth",
                            "label": "Graph width",
                            "description": "Width of the graph area on the right",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 128,
                            "min": 60,
                            "max": 220,
                            "step": 1,
                            "suffix": "px"
                        },
                        {
                            "id": "graphHeight",
                            "label": "Graph height",
                            "description": "Height of the graph area",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 56,
                            "min": 24,
                            "max": 100,
                            "step": 1,
                            "suffix": "px"
                        }
                    ]
                },
                {
                    "id": "footer",
                    "label": "Footer",
                    "description": "The small line at the bottom of the card.",
                    "fields": [
                        {
                            "id": "showFooter",
                            "label": "Show footer",
                            "description": "",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": true
                        },
                        {
                            "id": "footerText",
                            "label": "Footer text",
                            "description": "",
                            "dataType": "string",
                            "fieldType": "text",
                            "default": "24h Live Market Tracking"
                        },
                        {
                            "id": "footerShowSource",
                            "label": "Append data source",
                            "description": "Adds \"· CoinGecko\" / \"· CoinMarketCap\"",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": true
                        },
                        {
                            "id": "footerFont",
                            "label": "Footer font",
                            "description": "",
                            "dataType": "string",
                            "fieldType": "fontpicker",
                            "format": "font",
                            "default": "Sans 8"
                        },
                        {
                            "id": "footerColor",
                            "label": "Footer color",
                            "description": "",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#7C889AFF",
                            "schemeRole": "text-2"
                        }
                    ]
                },
                {
                    "id": "card",
                    "label": "Card",
                    "description": "Background and spacing. Corner radius, blur, shadow, border and opacity are on the Appearance tab.",
                    "fields": [
                        {
                            "id": "card-background-color",
                            "label": "Background color",
                            "description": "Card background. Use the alpha slider for transparency.",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#1E2530F5",
                            "schemeRole": "card-background"
                        },
                        {
                            "id": "cardPadding",
                            "label": "Inner padding",
                            "description": "Space between the card edge and its content",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 16,
                            "min": 4,
                            "max": 40,
                            "step": 1,
                            "suffix": "px"
                        }
                    ]
                }
            ]
        }
    ]
}