{
    "version": "1.0",
    "tabs": [
        {
            "id": "general",
            "label": "GitHub Repo Stats",
            "description": "Repository and refresh settings",
            "groups": [
                {
                    "id": "repo",
                    "label": "Repository",
                    "description": "",
                    "fields": [
                        {
                            "id": "repoPath",
                            "label": "Repository (owner/name)",
                            "description": "GitHub repository to track, e.g. xenlism/gnome-widget-center",
                            "dataType": "string",
                            "fieldType": "text",
                            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
                            "default": "xenlism/gnome-widget-center"
                        },
                        {
                            "id": "githubToken",
                            "label": "GitHub token (optional)",
                            "description": "Personal access token to raise the API rate limit. Never included in exported theme packs.",
                            "dataType": "string",
                            "fieldType": "password",
                            "default": ""
                        }
                    ]
                },
                {
                    "id": "refresh",
                    "label": "Refresh",
                    "description": "",
                    "fields": [
                        {
                            "id": "refreshInterval",
                            "label": "Refresh interval",
                            "description": "How often to re-fetch data from GitHub. Unauthenticated requests are limited to 60/hour per IP, so keep this reasonably high.",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 15,
                            "min": 5,
                            "max": 1440,
                            "step": 1,
                            "suffix": "min"
                        }
                    ]
                },
                {
                    "id": "display",
                    "label": "Display",
                    "description": "Choose which stats to show",
                    "fields": [
                        {
                            "id": "showStars",
                            "label": "Show stars",
                            "description": "",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": true
                        },
                        {
                            "id": "showForks",
                            "label": "Show forks",
                            "description": "",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": true
                        },
                        {
                            "id": "showIssues",
                            "label": "Show open issues",
                            "description": "",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": true
                        },
                        {
                            "id": "showLatestRelease",
                            "label": "Show latest release",
                            "description": "Hidden automatically if the repository has never published a release",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": true
                        }
                    ]
                },
                {
                    "id": "card",
                    "label": "Card",
                    "description": "",
                    "fields": [
                        {
                            "id": "cardColor",
                            "label": "Background color",
                            "description": "Background color of the card",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "default": "#1c1f26ff"
                        },
                        {
                            "id": "cornerRadius",
                            "label": "Corner radius",
                            "description": "Roundness of the card's corners",
                            "dataType": "number",
                            "fieldType": "spinbutton",
                            "default": 18,
                            "min": 0,
                            "max": 60,
                            "step": 1,
                            "suffix": "px"
                        }
                    ]
                }
            ]
        },
        {
            "id": "shadow",
            "label": "Shadow",
            "description": "Drop shadow behind this widget.",
            "groups": [
                {
                    "id": "shadow",
                    "label": "Shadow effect",
                    "description": "Off by default. Default color is black at 30% transparency.",
                    "fields": [
                        {
                            "id": "shadowAngle",
                            "label": "Shadow angle",
                            "description": "Direction of the shadow in degrees (0 = right, 90 = down, 180 = left, 270 = up)",
                            "dataType": "integer",
                            "fieldType": "slider",
                            "default": 90,
                            "min": 0,
                            "max": 360,
                            "step": 1,
                            "suffix": "°",
                            "visibleIf": "shadowEnabled"
                        },
                        {
                            "id": "shadowDistance",
                            "label": "Shadow distance",
                            "description": "How far the shadow is offset, in pixels",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 6,
                            "min": 0,
                            "max": 60,
                            "step": 1,
                            "suffix": "px",
                            "visibleIf": "shadowEnabled"
                        }
                    ]
                }
            ]
        }
    ]
}