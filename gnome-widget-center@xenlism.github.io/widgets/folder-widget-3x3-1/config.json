{
  "version": "1.0",
  "tabs": [
    {
      "id": "general",
      "label": "Folder (3x3)",
      "description": "9 app shortcuts in a 3x3 icon grid, no labels",
      "icon": "view-grid-symbolic",
      "groups": [
        {
          "id": "apps",
          "label": "Apps",
          "description": "Up to 9 apps, filled left-to-right, top-to-bottom. Clicking an icon launches that app.",
          "fields": [
            {
              "id": "apps",
              "label": "Apps (max 9)",
              "description": "Pick installed apps or browse for a .desktop file",
              "dataType": "list",
              "fieldType": "list",
              "default": [
                "/usr/share/applications/google-chrome.desktop",
                "/usr/share/applications/brave-origin.desktop",
                "/usr/share/applications/GitKraken.desktop",
                "/usr/share/applications/firefox.desktop",
                "/usr/share/applications/org.gnome.Console.desktop",
                "/usr/share/applications/org.gnome.tweaks.desktop",
                "/usr/share/applications/org.gnome.Settings.desktop",
                "/usr/share/applications/gnome-system-monitor-kde.desktop",
                "/usr/share/applications/org.gnome.Extensions.desktop"
              ],
              "maxItems": 9,
              "item": {
                "dataType": "string",
                "format": "app",
                "scanDirectory": "/usr/share/applications"
              }
            }
          ]
        },
        {
          "id": "appearance",
          "label": "Appearance",
          "description": "",
          "fields": [
            {
              "id": "backgroundColor",
              "label": "Background color",
              "description": "Folder background. Use the alpha slider for transparency, e.g. #FFFFFF0F for white at ~85% transparent.",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "alpha": true,
              "default": "#070000a5"
            },
            {
              "id": "cornerRadius",
              "label": "Corner radius",
              "description": "Roundness of the folder background",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 18,
              "min": 0,
              "max": 64,
              "step": 1,
              "suffix": "px"
            }
          ]
        }
      ]
    },
    {
      "id": "shadow",
      "label": "Shadow",
      "description": "Drop shadow behind this widget.",
      "groups": [
        {
          "id": "shadow",
          "label": "Shadow effect",
          "description": "Off by default. Default color is black at 30% transparency.",
          "fields": [
            {
              "id": "shadowEnabled",
              "label": "Enable shadow",
              "description": "Add a drop shadow behind this widget",
              "dataType": "boolean",
              "fieldType": "switch",
              "default": false
            },
            {
              "id": "shadowColor",
              "label": "Shadow color",
              "description": "",
              "dataType": "string",
              "fieldType": "colorpicker",
              "default": "#000000",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowOpacity",
              "label": "Shadow transparency",
              "description": "Shadow opacity, 0-100%",
              "dataType": "integer",
              "fieldType": "slider",
              "default": 30,
              "min": 0,
              "max": 100,
              "step": 1,
              "suffix": "%",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowAngle",
              "label": "Shadow angle",
              "description": "Direction of the shadow in degrees (0 = right, 90 = down, 180 = left, 270 = up)",
              "dataType": "integer",
              "fieldType": "slider",
              "default": 90,
              "min": 0,
              "max": 360,
              "step": 1,
              "suffix": "°",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowDistance",
              "label": "Shadow distance",
              "description": "How far the shadow is offset, in pixels",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 6,
              "min": 0,
              "max": 60,
              "step": 1,
              "suffix": "px",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowBlur",
              "label": "Shadow blur",
              "description": "Blur radius, in pixels",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 16,
              "min": 0,
              "max": 100,
              "step": 1,
              "suffix": "px",
              "visibleIf": "shadowEnabled"
            }
          ]
        }
      ]
    }
  ]
}
