{
    "version": "1.0",
    "tabs": [
        {
            "id": "general",
            "label": "Image Slideshow",
            "description": "Crossfading slideshow through a folder of photos",
            "icon": "image-x-generic-symbolic",
            "groups": [
                {
                    "id": "card",
                    "label": "Card",
                    "description": "",
                    "fields": [
                        {
                            "id": "backgroundColor",
                            "label": "Background color",
                            "description": "Shows behind photos - visible as letterboxing when \"Fit\" is set to Contain.",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#000000FF"
                        }
                    ]
                },
                {
                    "id": "source",
                    "label": "Source",
                    "description": "",
                    "fields": [
                        {
                            "id": "folderPath",
                            "label": "Photos folder",
                            "description": "Folder to slideshow. Only its top-level files are used (subfolders aren't scanned). Supports png, jpg/jpeg, webp, bmp and gif (shown as a still frame).",
                            "dataType": "string",
                            "fieldType": "folderpicker",
                            "format": "folder",
                            "default": ""
                        }
                    ]
                },
                {
                    "id": "playback",
                    "label": "Playback",
                    "description": "",
                    "fields": [
                        {
                            "id": "intervalSeconds",
                            "label": "Time per photo",
                            "description": "How long each photo stays on screen",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 8,
                            "min": 2,
                            "max": 300,
                            "step": 1,
                            "suffix": "s"
                        },
                        {
                            "id": "transitionMs",
                            "label": "Crossfade duration",
                            "description": "",
                            "dataType": "integer",
                            "fieldType": "slider",
                            "default": 600,
                            "min": 0,
                            "max": 2000,
                            "step": 50,
                            "suffix": "ms"
                        },
                        {
                            "id": "order",
                            "label": "Order",
                            "description": "Shuffled order is re-shuffled each time it loops back to the start, so the same photo never shows twice in a row.",
                            "dataType": "string",
                            "fieldType": "dropdown",
                            "default": "sequential",
                            "options": [
                                {
                                    "value": "sequential",
                                    "label": "Sequential (by file name)"
                                },
                                {
                                    "value": "random",
                                    "label": "Shuffled"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "display",
                    "label": "Display",
                    "description": "",
                    "fields": [
                        {
                            "id": "fitMode",
                            "label": "Fit",
                            "description": "Contain keeps the whole photo visible (may letterbox). Stretch fills the card, ignoring aspect ratio.",
                            "dataType": "string",
                            "fieldType": "dropdown",
                            "default": "contain",
                            "options": [
                                {
                                    "value": "contain",
                                    "label": "Contain (keep aspect ratio)"
                                },
                                {
                                    "value": "stretch",
                                    "label": "Stretch to fill"
                                }
                            ]
                        },
                        {
                            "id": "showFileName",
                            "label": "Show file name",
                            "description": "Overlay the current file's name in the bottom corner",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": false
                        }
                    ]
                }
            ]
        },
        {
            "id": "shadow",
            "label": "Shadow",
            "description": "Drop shadow behind this widget.",
            "groups": [
                {
                    "id": "shadow",
                    "label": "Shadow effect",
                    "description": "Off by default. Default color is black at 30% transparency.",
                    "fields": [
                        {
                            "id": "shadowAngle",
                            "label": "Shadow angle",
                            "description": "Direction of the shadow in degrees (0 = right, 90 = down, 180 = left, 270 = up)",
                            "dataType": "integer",
                            "fieldType": "slider",
                            "default": 90,
                            "min": 0,
                            "max": 360,
                            "step": 1,
                            "suffix": "\u00b0",
                            "visibleIf": "shadowEnabled"
                        },
                        {
                            "id": "shadowDistance",
                            "label": "Shadow distance",
                            "description": "How far the shadow is offset, in pixels",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 6,
                            "min": 0,
                            "max": 60,
                            "step": 1,
                            "suffix": "px",
                            "visibleIf": "shadowEnabled"
                        }
                    ]
                }
            ]
        }
    ]
}
