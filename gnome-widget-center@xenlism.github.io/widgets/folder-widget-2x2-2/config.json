{
  "version": "1.0",
  "tabs": [
    {
      "id": "general",
      "label": "Folder (2x2)",
      "description": "4 app shortcuts in a 2x2 icon grid, no labels",
      "icon": "view-grid-symbolic",
      "groups": [
        {
          "id": "apps",
          "label": "Apps",
          "description": "Up to 4 apps, filled left-to-right, top-to-bottom. Clicking an icon launches that app.",
          "fields": [
            {
              "id": "apps",
              "label": "Apps (max 4)",
              "description": "Pick installed apps or browse for a .desktop file",
              "dataType": "list",
              "fieldType": "list",
              "default": [],
              "maxItems": 4,
              "item": {
                "dataType": "string",
                "format": "app",
                "scanDirectory": "/usr/share/applications"
              }
            }
          ]
        },
        {
          "id": "appearance",
          "label": "Appearance",
          "description": "",
          "fields": [
            {
              "id": "backgroundColor",
              "label": "Background color",
              "description": "Folder background. Use the alpha slider for transparency, e.g. #FFFFFF0F for white at ~85% transparent.",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "alpha": true,
              "default": "#FFFFFF0F"
            },
            {
              "id": "cornerRadius",
              "label": "Corner radius",
              "description": "Roundness of the folder background",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 18,
              "min": 0,
              "max": 64,
              "step": 1,
              "suffix": "px"
            }
          ]
        }
      ]
    }
  ]
}
