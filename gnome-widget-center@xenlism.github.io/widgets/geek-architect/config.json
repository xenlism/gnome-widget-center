                            "min": 0,
                            "max": 100,
                            "step": 1,
                            "suffix": "%",
                            "visibleIf": "line2ShadowEnabled"
                        },
                        {
                            "id": "line2ShadowDistance",
                            "label": "Shadow distance",
                            "description": "How far the shadow is offset, in pixels.",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 2,
                            "min": 0,
                            "max": 30,
                            "step": 1,
                            "suffix": "px",
                            "visibleIf": "line2ShadowEnabled"
                        },
                        {
                            "id": "line2ShadowBlur",
                            "label": "Shadow blur",
                            "description": "Blur radius, in pixels.",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 4,
                            "min": 0,
                            "max": 40,
                            "step": 1,
                            "suffix": "px",
                            "visibleIf": "line2ShadowEnabled"
                        }
                    ]
                }
            ]
        },
