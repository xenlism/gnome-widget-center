{
    "version": "1.0",
    "tabs": [
        {
            "id": "general",
            "label": "Clock (Modern)",
            "description": "Vertical stacked-digit clock card settings",
            "icon": "preferences-system-time-symbolic",
            "groups": [
                {
                    "id": "format",
                    "label": "Format",
                    "description": "",
                    "fields": [
                        {
                            "id": "format24h",
                            "label": "24-hour format",
                            "description": "Off shows 12-hour time with an am/pm line above HH",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": true
                        }
                    ]
                },
                {
                    "id": "font",
                    "label": "Font",
                    "description": "HH, MM and SS always share the same face and size below. am/pm has its own separate face and size.",
                    "fields": [
                        {
                            "id": "font",
                            "label": "HH / MM / SS font",
                            "description": "Font face and size for the hour, minute and second digits",
                            "dataType": "string",
                            "fieldType": "fontpicker",
                            "format": "font",
                            "default": "Sans Bold 30"
                        },
                        {
                            "id": "ampmFont",
                            "label": "am/pm font",
                            "description": "Font face and size for the am/pm indicator",
                            "dataType": "string",
                            "fieldType": "fontpicker",
                            "format": "font",
                            "default": "Sans Bold 10"
                        }
                    ]
                },
                {
                    "id": "colors",
                    "label": "Colors",
                    "description": "HH, MM and SS each have their own separate color.",
                    "fields": [
                        {
                            "id": "colorHH",
                            "label": "HH color",
                            "description": "Color of the hour digits",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "default": "#1a1a1a"
                        },
                        {
                            "id": "colorMM",
                            "label": "MM color",
                            "description": "Color of the minute digits",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "default": "#1a1a1a"
                        },
                        {
                            "id": "colorSS",
                            "label": "SS color",
                            "description": "Color of the second digits",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "default": "rgb(165,29,45)"
                        },
                        {
                            "id": "colorAmPm",
                            "label": "am/pm color",
                            "description": "Color of the am/pm indicator",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "default": "#d81f26"
                        },
                        {
                            "id": "cardColor",
                            "label": "Card background color",
                            "description": "Background color of the clock card",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "default": "#ffffff"
                        }
                    ]
                },
                {
                    "id": "card",
                    "label": "Card shape",
                    "description": "",
                    "fields": [
                        {
                            "id": "cornerRadius",
                            "label": "Corner radius",
                            "description": "Roundness of the clock card's corners",
                            "dataType": "number",
                            "fieldType": "spinbutton",
                            "default": 18,
                            "min": 0,
                            "max": 60,
                            "step": 1,
                            "suffix": "px"
                        }
                    ]
                },
                {
                    "id": "borderOpacity",
                    "label": "Border & Opacity",
                    "description": "",
                    "fields": [
                        {
                            "id": "borderEnabled",
                            "label": "Enable border",
                            "description": "Draw a border around this widget's card",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": false
                        },
                        {
                            "id": "borderColor",
                            "label": "Border color",
                            "description": "",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "format": "color",
                            "alpha": true,
                            "default": "#FFFFFF33",
                            "visibleIf": "borderEnabled"
                        },
                        {
                            "id": "borderWidth",
                            "label": "Border width",
                            "description": "",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 1,
                            "min": 0,
                            "max": 16,
                            "step": 1,
                            "suffix": "px",
                            "visibleIf": "borderEnabled"
                        },
                        {
                            "id": "opacity",
                            "label": "Opacity",
                            "description": "Fades the entire widget - background, text, icons, everything.",
                            "dataType": "integer",
                            "fieldType": "slider",
                            "default": 100,
                            "min": 0,
                            "max": 100,
                            "step": 1,
                            "suffix": "%"
                        }
                    ]
                },
                {
                    "id": "launch",
                    "label": "Launch on click",
                    "description": "Clicking the clock (without holding Super) launches the chosen app.",
                    "fields": [
                        {
                            "id": "launchOnClick",
                            "label": "Launch app on click",
                            "description": "Requires an app to be chosen below",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": true
                        },
                        {
                            "id": "desktopFilePath",
                            "label": "App to launch",
                            "description": "Application (.desktop file) launched on click",
                            "dataType": "string",
                            "fieldType": "filepicker",
                            "format": "file",
                            "default": "/usr/share/applications/firefox.desktop",
                            "filters": [
                                "*.desktop"
                            ],
                            "enabledIf": "launchOnClick"
                        }
                    ]
                }
            ]
        },
        {
            "id": "shadow",
            "label": "Shadow",
            "description": "Drop shadow behind this widget.",
            "groups": [
                {
                    "id": "shadow",
                    "label": "Shadow effect",
                    "description": "Off by default. Default color is black at 30% transparency.",
                    "fields": [
                        {
                            "id": "shadowEnabled",
                            "label": "Enable shadow",
                            "description": "Add a drop shadow behind this widget",
                            "dataType": "boolean",
                            "fieldType": "switch",
                            "default": false
                        },
                        {
                            "id": "shadowColor",
                            "label": "Shadow color",
                            "description": "",
                            "dataType": "string",
                            "fieldType": "colorpicker",
                            "default": "#000000",
                            "visibleIf": "shadowEnabled"
                        },
                        {
                            "id": "shadowOpacity",
                            "label": "Shadow transparency",
                            "description": "Shadow opacity, 0-100%",
                            "dataType": "integer",
                            "fieldType": "slider",
                            "default": 30,
                            "min": 0,
                            "max": 100,
                            "step": 1,
                            "suffix": "%",
                            "visibleIf": "shadowEnabled"
                        },
                        {
                            "id": "shadowAngle",
                            "label": "Shadow angle",
                            "description": "Direction of the shadow in degrees (0 = right, 90 = down, 180 = left, 270 = up)",
                            "dataType": "integer",
                            "fieldType": "slider",
                            "default": 90,
                            "min": 0,
                            "max": 360,
                            "step": 1,
                            "suffix": "°",
                            "visibleIf": "shadowEnabled"
                        },
                        {
                            "id": "shadowDistance",
                            "label": "Shadow distance",
                            "description": "How far the shadow is offset, in pixels",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 6,
                            "min": 0,
                            "max": 60,
                            "step": 1,
                            "suffix": "px",
                            "visibleIf": "shadowEnabled"
                        },
                        {
                            "id": "shadowBlur",
                            "label": "Shadow blur",
                            "description": "Blur radius, in pixels",
                            "dataType": "integer",
                            "fieldType": "spinbutton",
                            "default": 16,
                            "min": 0,
                            "max": 100,
                            "step": 1,
                            "suffix": "px",
                            "visibleIf": "shadowEnabled"
                        }
                    ]
                }
            ]
        }
    ]
}