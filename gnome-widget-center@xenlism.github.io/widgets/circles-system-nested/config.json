{
  "version": "1.0",
  "tabs": [
    {
      "id": "general",
      "label": "System Monitor Mini",
      "description": "CPU / Memory / Disk concentric ring gauges",
      "icon": "utilities-system-monitor-symbolic",
      "groups": [
        {
          "id": "card",
          "label": "Card",
          "description": "",
          "fields": [
            {
              "id": "backgroundColor",
              "label": "Background color",
              "description": "Card background. Use the alpha slider for transparency.",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "alpha": true,
              "default": "#000000a9"
            },
            {
              "id": "cornerRadius",
              "label": "Corner radius",
              "description": "Roundness of the card corners",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 18,
              "min": 0,
              "max": 64,
              "step": 1,
              "suffix": "px"
            }
          ]
        },
        {
          "id": "rings",
          "label": "Ring colors",
          "description": "CPU is the outermost ring, Memory the middle ring, Disk the innermost ring.",
          "fields": [
            {
              "id": "circleBaseColor",
              "label": "Circle base color (track)",
              "description": "Shared base/track color drawn behind all three progress rings",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "alpha": true,
              "default": "#FFFFFF26"
            },
            {
              "id": "cpuRingColor",
              "label": "CPU ring color (outer)",
              "description": "Progress color of the outermost ring",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "alpha": true,
              "default": "#33D17AFF"
            },
            {
              "id": "memRingColor",
              "label": "Memory ring color (middle)",
              "description": "Progress color of the middle ring",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "alpha": true,
              "default": "#3584E4FF"
            },
            {
              "id": "hddRingColor",
              "label": "Disk ring color (inner)",
              "description": "Progress color of the innermost ring",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "alpha": true,
              "default": "#F5C211FF"
            },
            {
              "id": "ringThickness",
              "label": "Ring thickness",
              "description": "Stroke width shared by all three rings",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 9,
              "min": 3,
              "max": 20,
              "step": 1,
              "suffix": "px"
            },
            {
              "id": "ringGap",
              "label": "Gap between rings",
              "description": "Empty space separating each concentric ring from the next",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 3,
              "min": 0,
              "max": 12,
              "step": 1,
              "suffix": "px"
            }
          ]
        },
        {
          "id": "text",
          "label": "Center text",
          "description": "Small stacked legend in the middle of the rings, one line per metric, each colored to match its own ring.",
          "fields": [
            {
              "id": "showCenterText",
              "label": "Show center text",
              "description": "Show the CPU/MEM/DSK percentage legend in the middle",
              "dataType": "boolean",
              "fieldType": "switch",
              "default": true
            },
            {
              "id": "centerFont",
              "label": "Center text font",
              "description": "Face and size shared by all three legend lines",
              "dataType": "string",
              "fieldType": "fontpicker",
              "format": "font",
              "default": "Sans Bold 10",
              "visibleIf": "showCenterText"
            }
          ]
        },
        {
          "id": "behavior",
          "label": "Behavior",
          "description": "",
          "fields": [
            {
              "id": "refreshRateSeconds",
              "label": "Refresh rate",
              "description": "How often CPU/Memory/Disk are re-read",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 2,
              "min": 1,
              "max": 60,
              "step": 1,
              "suffix": "s"
            }
          ]
        }
      ]
    },
    {
      "id": "shadow",
      "label": "Shadow",
      "description": "Drop shadow behind this widget.",
      "groups": [
        {
          "id": "shadow",
          "label": "Shadow effect",
          "description": "Off by default. Default color is black at 30% transparency.",
          "fields": [
            {
              "id": "shadowEnabled",
              "label": "Enable shadow",
              "description": "Add a drop shadow behind this widget",
              "dataType": "boolean",
              "fieldType": "switch",
              "default": false
            },
            {
              "id": "shadowColor",
              "label": "Shadow color",
              "description": "",
              "dataType": "string",
              "fieldType": "colorpicker",
              "default": "#000000",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowOpacity",
              "label": "Shadow transparency",
              "description": "Shadow opacity, 0-100%",
              "dataType": "integer",
              "fieldType": "slider",
              "default": 30,
              "min": 0,
              "max": 100,
              "step": 1,
              "suffix": "%",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowAngle",
              "label": "Shadow angle",
              "description": "Direction of the shadow in degrees (0 = right, 90 = down, 180 = left, 270 = up)",
              "dataType": "integer",
              "fieldType": "slider",
              "default": 90,
              "min": 0,
              "max": 360,
              "step": 1,
              "suffix": "°",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowDistance",
              "label": "Shadow distance",
              "description": "How far the shadow is offset, in pixels",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 6,
              "min": 0,
              "max": 60,
              "step": 1,
              "suffix": "px",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowBlur",
              "label": "Shadow blur",
              "description": "Blur radius, in pixels",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 16,
              "min": 0,
              "max": 100,
              "step": 1,
              "suffix": "px",
              "visibleIf": "shadowEnabled"
            }
          ]
        }
      ]
    }
  ]
}
