{
  "version": "1.0",
  "tabs": [
    {
      "id": "general",
      "label": "Network (Half Ring)",
      "description": "Half-circle network rings settings",
      "icon": "network-wired-symbolic",
      "groups": [
        {
          "id": "card",
          "label": "Card",
          "description": "",
          "fields": [
            {
              "id": "backgroundColor",
              "label": "Background color",
              "description": "Card background. Use the alpha slider for transparency.",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "alpha": true,
              "default": "#FFFFFF00"
            },
            {
              "id": "cornerRadius",
              "label": "Corner radius",
              "description": "Roundness of the card corners",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 18,
              "min": 0,
              "max": 64,
              "step": 1,
              "suffix": "px"
            }
          ]
        },
        {
          "id": "borderOpacity",
          "label": "Border & Opacity",
          "description": "",
          "fields": [
            {
              "id": "borderEnabled",
              "label": "Enable border",
              "description": "Draw a border around this widget's card",
              "dataType": "boolean",
              "fieldType": "switch",
              "default": false
            },
            {
              "id": "borderColor",
              "label": "Border color",
              "description": "",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "alpha": true,
              "default": "#FFFFFF33",
              "visibleIf": "borderEnabled"
            },
            {
              "id": "borderWidth",
              "label": "Border width",
              "description": "",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 1,
              "min": 0,
              "max": 16,
              "step": 1,
              "suffix": "px",
              "visibleIf": "borderEnabled"
            },
            {
              "id": "opacity",
              "label": "Opacity",
              "description": "Fades the entire widget - background, text, icons, everything.",
              "dataType": "integer",
              "fieldType": "slider",
              "default": 100,
              "min": 0,
              "max": 100,
              "step": 1,
              "suffix": "%"
            }
          ]
        },
        {
          "id": "rings",
          "label": "Rings",
          "description": "",
          "fields": [
            {
              "id": "circleBaseColor",
              "label": "Ring base color (track)",
              "description": "Base/track color drawn behind both half-rings",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "alpha": true,
              "default": "#FFFFFF26"
            },
            {
              "id": "downloadColor",
              "label": "Outer ring color (Download)",
              "description": "Download ring color and download number color",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "alpha": true,
              "default": "#5AC8FAFF"
            },
            {
              "id": "uploadColor",
              "label": "Inner ring color (Upload)",
              "description": "Upload ring color and upload number color",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "alpha": true,
              "default": "#FF9F0AFF"
            },
            {
              "id": "ringThickness",
              "label": "Ring thickness",
              "description": "Stroke width of the base track and both half-rings",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 9,
              "min": 3,
              "max": 24,
              "step": 1,
              "suffix": "px"
            },
            {
              "id": "ringSide",
              "label": "Ring side",
              "description": "Which side holds the half-rings. Their curves bend inward toward the text.",
              "dataType": "string",
              "fieldType": "dropdown",
              "default": "right",
              "options": [
                {
                  "value": "right",
                  "label": "Right (curves inward left)"
                },
                {
                  "value": "left",
                  "label": "Left (curves inward right)"
                }
              ]
            }
          ]
        },
        {
          "id": "text",
          "label": "Text",
          "description": "",
          "fields": [
            {
              "id": "captionText",
              "label": "Caption text",
              "description": "Small label shown above the speed numbers",
              "dataType": "string",
              "fieldType": "text",
              "default": "NET"
            },
            {
              "id": "captionFont",
              "label": "Caption font",
              "description": "Face and size of the caption label",
              "dataType": "string",
              "fieldType": "fontpicker",
              "format": "font",
              "default": "Sans 10"
            },
            {
              "id": "captionColor",
              "label": "Caption color",
              "description": "Color of the caption label",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "alpha": true,
              "default": "#FFFFFFB3"
            },
            {
              "id": "valueFont",
              "label": "Speed number font",
              "description": "Face and size used for the download/upload speed numbers",
              "dataType": "string",
              "fieldType": "fontpicker",
              "format": "font",
              "default": "Sans Bold 13"
            }
          ]
        },
        {
          "id": "behavior",
          "label": "Behavior",
          "description": "",
          "fields": [
            {
              "id": "refreshRateSeconds",
              "label": "Refresh rate",
              "description": "How often the network reading updates",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 2,
              "min": 1,
              "max": 60,
              "step": 1,
              "suffix": "s"
            }
          ]
        }
      ]
    },
    {
      "id": "shadow",
      "label": "Shadow",
      "description": "Drop shadow behind this widget.",
      "groups": [
        {
          "id": "shadow",
          "label": "Shadow effect",
          "description": "Off by default. Default color is black at 30% transparency.",
          "fields": [
            {
              "id": "shadowEnabled",
              "label": "Enable shadow",
              "description": "Add a drop shadow behind this widget",
              "dataType": "boolean",
              "fieldType": "switch",
              "default": false
            },
            {
              "id": "shadowColor",
              "label": "Shadow color",
              "description": "",
              "dataType": "string",
              "fieldType": "colorpicker",
              "default": "#000000",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowOpacity",
              "label": "Shadow transparency",
              "description": "Shadow opacity, 0-100%",
              "dataType": "integer",
              "fieldType": "slider",
              "default": 30,
              "min": 0,
              "max": 100,
              "step": 1,
              "suffix": "%",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowAngle",
              "label": "Shadow angle",
              "description": "Direction of the shadow in degrees (0 = right, 90 = down, 180 = left, 270 = up)",
              "dataType": "integer",
              "fieldType": "slider",
              "default": 90,
              "min": 0,
              "max": 360,
              "step": 1,
              "suffix": "°",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowDistance",
              "label": "Shadow distance",
              "description": "How far the shadow is offset, in pixels",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 6,
              "min": 0,
              "max": 60,
              "step": 1,
              "suffix": "px",
              "visibleIf": "shadowEnabled"
            },
            {
              "id": "shadowBlur",
              "label": "Shadow blur",
              "description": "Blur radius, in pixels",
              "dataType": "integer",
              "fieldType": "spinbutton",
              "default": 16,
              "min": 0,
              "max": 100,
              "step": 1,
              "suffix": "px",
              "visibleIf": "shadowEnabled"
            }
          ]
        }
      ]
    }
  ]
}
