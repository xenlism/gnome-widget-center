  "packMeta": {
    "id": "nothing-mono-grid-20260924150308",
    "name": "Nothing Mono Grid",
    "description": "A black-and-white, Nothing-inspired tile dashboard with monospace type and red accents: dashed digital clock, analog clock with a red second hand, weather, ring gauges for battery, CPU, memory, disk and network, media player, to-do list, and quick settings and power buttons in a centered grid.",
