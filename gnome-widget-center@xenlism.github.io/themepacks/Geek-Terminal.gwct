 "packMeta": {
    "id": "geek-terminal-20260924150105",
    "name": "Geek Terminal",
    "description": "A hacker-terminal-style tile dashboard: near-black cards with phosphor-green monospace type and amber accents. Stat clock, CPU, memory and network monitors, ring gauges for battery, disk, CPU, memory and network, weather, media player, to-do list, and quick settings and power buttons.",
    "author": "Keal",
    "email": "ixenatt@gmail.com",
