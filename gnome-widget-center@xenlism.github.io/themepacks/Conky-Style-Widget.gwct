  "packMeta": {
    "id": "conky-style-widget-20260924152009",
    "name": "Conky Style Widget",
    "description": "A text-first, card-free desktop in the style of Conky and Rainmeter: a floating clock and date, month calendar, to-do list, weather, CPU, memory and network readouts with sparklines, thin disk and battery rings, and quick settings and power buttons. All widgets are transparent with no shadows or borders.",
    "author": "Keal",
    "email": "ixenatt@gmail.com",
    "url": "https://github.com/xenlism"
  },
