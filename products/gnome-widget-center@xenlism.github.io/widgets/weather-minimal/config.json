{
  "version": "1.0",
  "tabs": [
    {
      "id": "general",
      "label": "Weather (Minimal)",
      "description": "Minimal weather card settings",
      "icon": "weather-clear-symbolic",
      "groups": [
        {
          "id": "location",
          "label": "Location",
          "description": "Resolved via Open-Meteo's free geocoding API (api.open-meteo.com) - no API key required.",
          "fields": [
            {
              "id": "place",
              "label": "Place",
              "description": "Type a city name and pick a suggestion - resolved via Open-Meteo's free geocoding API, no API key required",
              "dataType": "string",
              "fieldType": "autocomplete",
              "autocomplete": "searchPlace",
              "fillsField": "location",
              "default": "Bangkok, Thailand"
            },
            {
              "id": "location",
              "label": "Location",
              "description": "latitude,longitude - type a city name here too, or paste coordinates directly",
              "dataType": "string",
              "fieldType": "autocomplete",
              "autocomplete": "searchLocation",
              "fillsField": "place",
              "pattern": "^-?\\d{1,2}(\\.\\d+)?,-?\\d{1,3}(\\.\\d+)?$",
              "default": "13.756331,100.501762"
            }
          ]
        },
        {
          "id": "card",
          "label": "Card",
          "description": "",
          "fields": [
            {
              "id": "cardColor",
              "label": "Background color",
              "description": "Background color of the weather card",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "default": "#ffffff"
            },
            {
              "id": "cornerRadius",
              "label": "Corner radius",
              "description": "Roundness of the card's corners",
              "dataType": "number",
              "fieldType": "spinbutton",
              "default": 18,
              "min": 0,
              "max": 60,
              "step": 1,
              "suffix": "px"
            }
          ]
        },
        {
          "id": "icon",
          "label": "Weather Icon",
          "description": "Icon set based on weather-iconic (https://github.com/konradmichalik/weather-iconic) naming conventions.",
          "fields": [
            {
              "id": "iconColor",
              "label": "Icon color",
              "description": "Color the weather icon is tinted",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "default": "#1a1a1a"
            },
            {
              "id": "iconSize",
              "label": "Icon size",
              "description": "Size of the weather icon",
              "dataType": "number",
              "fieldType": "spinbutton",
              "default": 64,
              "min": 16,
              "max": 128,
              "step": 1,
              "suffix": "px"
            }
          ]
        },
        {
          "id": "condition",
          "label": "Weather Condition",
          "description": "The text line below the icon (e.g. \"Storm\", \"Rain\", \"Clear\")",
          "fields": [
            {
              "id": "conditionFont",
              "label": "Condition font",
              "description": "Font face and size for the condition text",
              "dataType": "string",
              "fieldType": "fontpicker",
              "format": "font",
              "default": "Sans Bold 16"
            },
            {
              "id": "conditionColor",
              "label": "Condition color",
              "description": "Color of the condition text",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "default": "#1a1a1a"
            }
          ]
        },
        {
          "id": "temp",
          "label": "Temperature",
          "description": "",
          "fields": [
            {
              "id": "tempFont",
              "label": "Temperature font",
              "description": "Font face and size for the temperature",
              "dataType": "string",
              "fieldType": "fontpicker",
              "format": "font",
              "default": "Sans Bold 34"
            },
            {
              "id": "tempColor",
              "label": "Temperature color",
              "description": "Color of the temperature text",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "default": "#1a1a1a"
            },
            {
              "id": "tempUnit",
              "label": "Unit",
              "description": "Celsius or Fahrenheit",
              "dataType": "string",
              "fieldType": "dropdown",
              "default": "celsius",
              "options": [
                {"value": "celsius", "label": "Celsius (°C)"},
                {"value": "fahrenheit", "label": "Fahrenheit (°F)"}
              ]
            }
          ]
        }
      ]
    }
  ]
}
