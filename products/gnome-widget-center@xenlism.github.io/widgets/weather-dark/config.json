{
  "version": "1.0",
  "tabs": [
    {
      "id": "general",
      "label": "Weather (Dark)",
      "description": "Dark weather card settings",
      "icon": "weather-clear-symbolic",
      "groups": [
        {
          "id": "location",
          "label": "Location",
          "description": "",
          "fields": [
            {
              "id": "location",
              "label": "Location",
              "description": "Coordinates as latitude,longitude - e.g. 15.1111,85.2555",
              "dataType": "string",
              "fieldType": "text",
              "pattern": "^-?\\d{1,2}(\\.\\d+)?\\s*,\\s*-?\\d{1,3}(\\.\\d+)?$",
              "default": "13.756331,100.501762"
            }
          ]
        },
        {
          "id": "card",
          "label": "Card",
          "description": "",
          "fields": [
            {
              "id": "cardColor",
              "label": "Background color",
              "description": "Background color of the weather card",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "default": "#1c1f26"
            },
            {
              "id": "cornerRadius",
              "label": "Corner radius",
              "description": "Roundness of the card's corners",
              "dataType": "number",
              "fieldType": "spinbutton",
              "default": 18,
              "min": 0,
              "max": 60,
              "step": 1,
              "suffix": "px"
            }
          ]
        },
        {
          "id": "icon",
          "label": "Weather Icon",
          "description": "Same icon set as Weather (Minimal), based on weather-iconic (https://github.com/konradmichalik/weather-iconic) naming conventions.",
          "fields": [
            {
              "id": "iconColor",
              "label": "Icon color",
              "description": "Color the weather icon is tinted",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "default": "#f2b544"
            },
            {
              "id": "iconSize",
              "label": "Icon size",
              "description": "Size of the weather icon",
              "dataType": "number",
              "fieldType": "spinbutton",
              "default": 72,
              "min": 16,
              "max": 160,
              "step": 1,
              "suffix": "px"
            }
          ]
        },
        {
          "id": "condition",
          "label": "Weather Condition",
          "description": "The text line below the temperature (e.g. \"Storm\", \"Rain\", \"Clear\")",
          "fields": [
            {
              "id": "conditionFont",
              "label": "Condition font",
              "description": "Font face and size for the condition text",
              "dataType": "string",
              "fieldType": "fontpicker",
              "format": "font",
              "default": "Sans 18"
            },
            {
              "id": "conditionColor",
              "label": "Condition color",
              "description": "Color of the condition text",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "default": "#e6e6e6"
            }
          ]
        },
        {
          "id": "temp",
          "label": "Temperature",
          "description": "",
          "fields": [
            {
              "id": "tempFont",
              "label": "Temperature font",
              "description": "Font face and size for the temperature",
              "dataType": "string",
              "fieldType": "fontpicker",
              "format": "font",
              "default": "Sans Bold 40"
            },
            {
              "id": "tempColor",
              "label": "Temperature color",
              "description": "Color of the temperature text",
              "dataType": "string",
              "fieldType": "colorpicker",
              "format": "color",
              "default": "#ffffff"
            },
            {
              "id": "tempUnit",
              "label": "Unit",
              "description": "Celsius or Fahrenheit",
              "dataType": "string",
              "fieldType": "dropdown",
              "default": "celsius",
              "options": [
                {"value": "celsius", "label": "Celsius (°C)"},
                {"value": "fahrenheit", "label": "Fahrenheit (°F)"}
              ]
            }
          ]
        }
      ]
    }
  ]
}
